{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "`", "close": "`", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["`", "`"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^[^#\"`]*[{(\\[][^})\\]#\"`]*(#.*)?$",
    "decreaseIndentPattern": "^\\s*[})\\]]"
  },
  "wordPattern": "[A-Za-z_\\u00c0-\\u024f\\u0370-\\u03ff][A-Za-z0-9_\\u00c0-\\u024f\\u0370-\\u03ff]*'*|-?[0-9][0-9_]*(?:\\.[0-9_]*)?(?:[eE][+-]?[0-9]+)?(?:~[0-9]+)?(?:im)?"
}
