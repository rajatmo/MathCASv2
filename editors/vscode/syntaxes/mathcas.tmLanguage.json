{
  "name": "MathCAS",
  "scopeName": "source.mathcas",
  "fileTypes": ["mc", "mcn"],
  "patterns": [
    { "include": "#header" },
    { "include": "#notebook-marker" },
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#backquoted" },
    { "include": "#decorator" },
    { "include": "#definition" },
    { "include": "#module" },
    { "include": "#number" },
    { "include": "#keyword" },
    { "include": "#pattern" },
    { "include": "#slot" },
    { "include": "#call" },
    { "include": "#qualified" },
    { "include": "#operator" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "header": {
      "comment": "the first line of a file or notebook: #! mathcas 2",
      "match": "\\A#!.*$",
      "name": "comment.line.shebang.mathcas"
    },
    "notebook-marker": {
      "comment": "notebook cell markers: #% cell, #% text, #% output",
      "match": "^(#%)\\s*([\\p{L}_][\\p{L}\\p{N}_]*)?.*$",
      "name": "meta.separator.cell.mathcas",
      "captures": {
        "1": { "name": "punctuation.definition.comment.mathcas" },
        "2": { "name": "keyword.other.cell.mathcas" }
      }
    },
    "comment": {
      "match": "(#).*$",
      "name": "comment.line.number-sign.mathcas",
      "captures": { "1": { "name": "punctuation.definition.comment.mathcas" } }
    },
    "string": {
      "begin": "\"",
      "end": "\"|$",
      "name": "string.quoted.double.mathcas",
      "patterns": [
        { "match": "\\\\(?:[nt\"\\\\]|u\\{[0-9A-Fa-f]{1,6}\\})", "name": "constant.character.escape.mathcas" },
        { "match": "\\\\.", "name": "invalid.illegal.escape.mathcas" }
      ]
    },
    "backquoted": {
      "comment": "a name in backquotes, such as `if` or `a b`",
      "begin": "`",
      "end": "`|$",
      "name": "variable.other.quoted.mathcas",
      "patterns": [{ "match": "\\\\(?:[nt\"\\\\`]|u\\{[0-9A-Fa-f]{1,6}\\})", "name": "constant.character.escape.mathcas" }]
    },
    "decorator": {
      "comment": "@listable, @identity(0), @on(square): @ directly followed by a name",
      "match": "(@)([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": { "name": "punctuation.definition.decorator.mathcas" },
        "2": { "name": "entity.name.function.decorator.mathcas" }
      }
    },
    "definition": {
      "comment": "fn name, rule name, sym name",
      "match": "\\b(fn|rule|sym)\\s+((?:[\\p{L}_][\\p{L}\\p{N}_]*\\.)*[\\p{L}_][\\p{L}\\p{N}_]*)(?![\\p{L}\\p{N}_])",
      "captures": {
        "1": { "name": "storage.type.function.mathcas" },
        "2": { "name": "entity.name.function.mathcas" }
      }
    },
    "module": {
      "comment": "module M, import M",
      "match": "\\b(module|import)\\s+((?:[\\p{L}_][\\p{L}\\p{N}_]*\\.)*[\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": { "name": "keyword.other.module.mathcas" },
        "2": { "name": "entity.name.namespace.mathcas" }
      }
    },
    "number": {
      "patterns": [
        {
          "comment": "ball literals: 1.25~40, 2~100",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9_]*)?(?:[eE][+-]?[0-9]+)?(~)[0-9]+(?:im)?\\b",
          "name": "constant.numeric.ball.mathcas",
          "captures": { "1": { "name": "keyword.operator.ball.mathcas" } }
        },
        { "match": "\\b0x[0-9A-Fa-f_]+(?:im)?\\b", "name": "constant.numeric.hex.mathcas" },
        { "match": "\\b0b[01_]+(?:im)?\\b", "name": "constant.numeric.binary.mathcas" },
        {
          "comment": "machine reals: 1.5, 1., 2e-10",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9_]*(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)(?:im)?(?![\\p{L}\\p{N}_])",
          "name": "constant.numeric.real.mathcas"
        },
        { "match": "\\b[0-9][0-9_]*(?:im)?\\b", "name": "constant.numeric.integer.mathcas" }
      ]
    },
    "keyword": {
      "patterns": [
        { "match": "\\b(if|then|else|while|for|in|match|when)\\b", "name": "keyword.control.mathcas" },
        { "match": "\\b(let|var|fn|rule|sym|held)\\b", "name": "storage.type.mathcas" },
        { "match": "\\b(module|pub|import)\\b", "name": "keyword.other.module.mathcas" },
        { "match": "\\b(and|or|not)\\b", "name": "keyword.operator.word.mathcas" },
        { "match": "\\b(true|false|null)\\b", "name": "constant.language.mathcas" },
        { "match": "\\b(pi|inf|im)\\b|[π∞]", "name": "constant.language.numeric.mathcas" }
      ]
    },
    "pattern": {
      "comment": "x_, xs__, rest___, _",
      "match": "(?<![\\p{L}\\p{N}_])([\\p{L}][\\p{L}\\p{N}_]*?)?(_{1,3})(?![\\p{L}\\p{N}_])",
      "captures": {
        "1": { "name": "variable.parameter.pattern.mathcas" },
        "2": { "name": "keyword.operator.pattern.mathcas" }
      }
    },
    "slot": {
      "match": "&[0-9]+",
      "name": "variable.language.slot.mathcas"
    },
    "call": {
      "comment": "a call f(...) or M.f(...)",
      "match": "((?:[\\p{L}_][\\p{L}\\p{N}_]*\\.)*[\\p{L}_][\\p{L}\\p{N}_]*)('*)(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.mathcas" },
        "2": { "name": "keyword.operator.prime.mathcas" }
      }
    },
    "qualified": {
      "comment": "M.f: the module part",
      "match": "([\\p{L}_][\\p{L}\\p{N}_]*)(\\.)(?=[\\p{L}_])",
      "captures": {
        "1": { "name": "entity.name.namespace.mathcas" },
        "2": { "name": "punctuation.accessor.mathcas" }
      }
    },
    "operator": {
      "patterns": [
        { "match": "===|!==|==|!=|<=|>=|<|>", "name": "keyword.operator.comparison.mathcas" },
        { "match": ":=|=", "name": "keyword.operator.assignment.mathcas" },
        { "match": "\\|>|->|:>|=>", "name": "keyword.operator.arrow.mathcas" },
        { "match": "\\.\\.\\.", "name": "keyword.operator.rest.mathcas" },
        { "match": "[-+*/^]", "name": "keyword.operator.arithmetic.mathcas" },
        { "match": "[|@&]", "name": "keyword.operator.other.mathcas" },
        { "match": "'+", "name": "keyword.operator.prime.mathcas" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "match": "[,;]", "name": "punctuation.separator.mathcas" },
        { "match": ":", "name": "punctuation.separator.type.mathcas" },
        { "match": "[()\\[\\]{}]", "name": "punctuation.bracket.mathcas" }
      ]
    }
  }
}
