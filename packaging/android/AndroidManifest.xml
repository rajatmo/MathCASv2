<?xml version="1.0" encoding="utf-8"?>
<!-- The MathCAS Notebook app: one activity. It is the system's NativeActivity, which loads the notebook's native
     library (crates/mc-notebook-android), with a few Java methods for the share sheet, the clipboard and the document
     picker (java/). build-apk.sh fills in @VERSION@ and @CODE@. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.rajatmo.mathcas"
    android:versionCode="@CODE@"
    android:versionName="@VERSION@">

    <!-- Android 9 and later. The target stays at 14: from 15 on the system draws every app under its status and
         navigation bars, and a native activity is not told where they are. -->
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="34" />

    <!-- OpenGL ES 3.0 (the window is drawn with it, or with Vulkan) -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- extractNativeLibs: the kernel is a program (lib/<abi>/libmc_kernel.so) the notebook starts, so the native
         libraries must be unpacked to files -->
    <application
        android:label="MathCAS Notebook"
        android:icon="@mipmap/icon"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:allowBackup="true">
        <activity
            android:name=".MathCasActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale">
            <meta-data android:name="android.app.lib_name" android:value="mc_notebook_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with" for notebooks: a file named *.mcn in a file manager or another app -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.mcn" />
                <data android:pathPattern=".*\\..*\\.mcn" />
            </intent-filter>
        </activity>
        <!-- lets the app chosen in the share sheet read the one file that is shared -->
        <provider
            android:name=".SharedFiles"
            android:authorities="io.github.rajatmo.mathcas.shared"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
