<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-mathcas-notebook">
    <comment>MathCAS notebook</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.mcn"/>
  </mime-type>
  <mime-type type="text/x-mathcas-script">
    <comment>MathCAS script</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.mc"/>
  </mime-type>
</mime-info>
