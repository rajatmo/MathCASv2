#! mathcas 2 notebook

#% title
# prepend

#% text
# `prepend(xs, x)` gives the list `xs` with `x` added at the start.

#% section
# Details

#% item
# A new list is made; `xs` is unchanged.

#% item
# A list `x` is added as one element.

#% section
# Examples

#% subsection
# Basic examples

#% cell
prepend([b, c], a)
#% output
#= [a, b, c]

#% cell
prepend([], 1)
#% output
#= [1]

#% cell
prepend([[1, 2]], [0, 0])
#% output
#= [[0, 0], [1, 2]]

#% subsection
# Applications

#% text
# A recursive definition that builds its result from the front: the Collatz path of a number.

#% cell
fn collatz(1) = [1]
fn collatz(n: Int) = prepend(collatz(if is_even(n) then n/2 else 3n + 1), n)
collatz(6)
#% output
#= [6, 3, 10, 5, 16, 8, 4, 2, 1]

#% text
# A header row put in front of a table:

#% cell
prepend(table([k, k^2], k, 3), ["k", "k^2"])
#% output
#= [["k", "k^2"], [1, 1], [2, 4], [3, 9]]

#% subsection
# Properties and relations

#% text
# `first` takes back what `prepend` added:

#% cell
first(prepend([2, 3], 1))
#% output
#= 1

#% cell
prepend([2, 3], 1) === join([1], [2, 3])
#% output
#= true

#% section
# See also

#% text
# `append`, `join`, `rest`, `first`
