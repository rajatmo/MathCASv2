#! mathcas 2 notebook

#% title
# radial_axis_plot

#% text
# `radial_axis_plot(v)` draws each vector as a closed polygon over axes radiating from a centre (a radar chart).

#% section
# Details

#% item
# Each axis is scaled to the largest value on it, written at its end.

#% section
# Examples

#% subsection
# Basic examples

#% cell
radial_axis_plot([9, 7, 9, 5, 5, 7])
#% output
#= image("radial_axis_plot.files/radial_axis_plot-1.svgz")

#% cell
radial_axis_plot([[9, 7, 9, 5, 5, 7], [6, 2, 3, 8, 8, 7]])
#% output
#= image("radial_axis_plot.files/radial_axis_plot-2.svgz")

