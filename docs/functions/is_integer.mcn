#! mathcas 2 notebook

#% title
# is_integer

#% text
# `is_integer(x)` gives `true` when `x` is an exact integer, else `false`.

#% section
# Details

#% item
# A machine real with no fractional part, such as `3.0`, is not an integer.

#% section
# Examples

#% subsection
# Basic examples

#% cell
is_integer(42)
#% output
#= true

#% cell
is_integer(3/2)
#% output
#= false

#% cell
is_integer(3.0)
#% output
#= false

#% subsection
# Scope

#% text
# Select the integers of a list:

#% cell
select([1, 2.5, 3, x, 4/2], is_integer)
#% output
#= [1, 3, 2]

#% section
# See also

#% text
# `is_rational`, `is_number`, `round`, `is_even`
