#! mathcas 2 notebook

#% title
# light_blue

#% text
# `light_blue` is the colour light blue, a pale tint of `blue`: a directive for graphics and a value for plot options such as `colors:`.

#% section
# Details

#% item
# `light_blue` is a named colour like `blue`; it stays a symbol until a graphic draws it.

#% item
# Pale tints suit filled areas and backgrounds behind darker curves.

#% section
# Examples

#% subsection
# Basic examples

#% cell
graphics([light_blue, disk()])
#% output
#= image("light_blue.files/light_blue-1.svgz")

#% cell
plot([sin(x), cos(x)], [x, 0, 2*pi], colors: [blue, light_blue])
#% output
#= image("light_blue.files/light_blue-2.svgz")

#% cell
light_blue
#% output
#= light_blue

#% subsection
# Scope

#% text
# The tint beside the full colour and its darker shade:

#% cell
graphics([[light_blue, disk([0, 0])], [blue, disk([2, 0])], [darker(blue), disk([4, 0])]])
#% output
#= image("light_blue.files/light_blue-4.svgz")

#% subsection
# Applications

#% text
# A pale band behind a curve:

#% cell
graphics([[light_blue, rectangle([0, -1], [3, 1])], [black, line(table([t, sin(2*t)], t, range(0, 3, 0.05)))]])
#% output
#= image("light_blue.files/light_blue-5.svgz")

#% section
# See also

#% text
# `blue`, `light_gray`, `lighter`, `rgb_color`, `light_yellow`
