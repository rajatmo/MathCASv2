#! mathcas 2 notebook

#% title
# permutation_cycles

#% text
# `permutation_cycles(list)`: the permutation with this list of images, as cycles

#% section
# Details

#% item
# The argument is a list containing each of 1, ..., n once.

#% section
# Examples

#% subsection
# Basic examples

#% cell
permutation_cycles([3, 1, 2, 4])
#% output
#= cycles([[1, 3, 2]])

#% cell
permutation_cycles(permutation_list(cycles([[2, 7, 4]])))
#% output
#= cycles([[2, 7, 4]])

#% section
# See also

#% text
# `permutation_list`, `cycles`
