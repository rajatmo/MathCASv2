#! mathcas 2 notebook

#% title
# divide

#% text
# `divide(a, b)` is `a/b`.

#% section
# Details

#% item
# As a function value it can be given to `fold`, `map_apply` and the like.

#% section
# Examples

#% subsection
# Basic examples

#% cell
divide(x, y)
#% output
#= x/y

#% cell
fold_list(divide, 1, range(5))
#% output
#= [1, 1, 1/2, 1/6, 1/24, 1/120]

