#! mathcas 2 notebook

#% title
# light_brown

#% text
# `light_brown` is the colour light brown, a pale tint of `brown`: a directive for graphics and a value for plot options such as `colors:`.

#% section
# Details

#% item
# `light_brown` is a named colour like `brown`; it stays a symbol until a graphic draws it.

#% item
# Pale tints suit filled areas and backgrounds behind darker curves.

#% section
# Examples

#% subsection
# Basic examples

#% cell
graphics([light_brown, disk()])
#% output
#= image("light_brown.files/light_brown-1.svgz")

#% cell
plot([sin(x), cos(x)], [x, 0, 2*pi], colors: [brown, light_brown])
#% output
#= image("light_brown.files/light_brown-2.svgz")

#% cell
light_brown
#% output
#= light_brown

#% subsection
# Scope

#% text
# The tint beside the full colour and its darker shade:

#% cell
graphics([[light_brown, disk([0, 0])], [brown, disk([2, 0])], [darker(brown), disk([4, 0])]])
#% output
#= image("light_brown.files/light_brown-4.svgz")

#% subsection
# Applications

#% text
# A pale band behind a curve:

#% cell
graphics([[light_brown, rectangle([0, -1], [3, 1])], [black, line(table([t, sin(2*t)], t, range(0, 3, 0.05)))]])
#% output
#= image("light_brown.files/light_brown-5.svgz")

#% section
# See also

#% text
# `brown`, `light_gray`, `lighter`, `rgb_color`, `light_pink`
