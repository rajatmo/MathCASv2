#! mathcas 2 notebook

#% title
# tetrahedron

#% text
# `tetrahedron([p1, p2, p3, p4])` is the solid tetrahedron with these corners; `tetrahedron()` is the regular tetrahedron with edge 1 centred at the origin.

#% section
# Examples

#% subsection
# Basic examples

#% text
# Volume and centroid:

#% cell
region_measure(tetrahedron([[0, 0, 0], [2, 0, 0], [0, 2, 0], [0, 0, 2]]))
#% output
#= 4/3

#% cell
region_centroid(tetrahedron())
#% output
#= [0, 0, 0]

