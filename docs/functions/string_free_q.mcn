#% title
# string_free_q

#% text
# `string_free_q(s, p)` gives `true` when no substring of `s` matches the string pattern `p`.

#% section
# Examples

#% subsection
# Basic examples

#% cell
string_free_q("bcde", string_expression("c", __, "t"))
#% output
#= true

#% cell
string_free_q("abc1", digit_character)
#% output
#= false

