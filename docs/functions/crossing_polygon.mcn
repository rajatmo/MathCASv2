#! mathcas 2 notebook

#% title
# crossing_polygon

#% text
# `crossing_polygon(curve)`: the region a closed curve encloses by the even-odd rule (the loops that wind twice are left out), as a polygon

#% section
# Examples

#% subsection
# Basic examples

#% cell
star = [[0.35, 0.2], [0.9, 0.75], [0.1, 0.55], [0.9, 0.35], [0.42, 0.9]];

#% cell
crossing_polygon([[0, 0], [1, 0], [1, 1]])
#% output
#= polygon([[0, 0], [1, 0], [1, 1]])

#% cell
area(crossing_polygon(star))
#% output
#= 0.1259516575622045

