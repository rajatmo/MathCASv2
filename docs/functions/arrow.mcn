#! mathcas 2 notebook

#% title
# arrow

#% text
# `arrow([[x1, y1], ..., [xn, yn]])` is a graphics primitive: the polyline through the points with an arrowhead at [xn, yn].

#% text
# `arrow([[p1, ...], [q1, ...], ...])` is several arrows.

#% section
# Details

#% item
# The arrowhead points along the last segment and grows with the line's thickness.

#% item
# Drawn in the current colour, `thickness` and `dashing`; the head is always solid.

#% section
# Examples

#% subsection
# Basic examples

#% text
# An arrow from the origin:

#% cell
graphics(arrow([[0, 0], [1, 1]]))
#% output
#= image("arrow.files/arrow-1.png")

#% text
# Arrows of a small vector field:

#% cell
graphics([blue, arrow(table([[k, 0], [k + 0.5, k/4]], k, range(0, 3)))])
#% output
#= image("arrow.files/arrow-2.png")

#% subsection
# Scope

#% text
# A bent arrow with a label at its tip:

#% cell
graphics([arrow([[0, 0], [1, 0], [1, 1]]), text("end", [1, 1.15])])
#% output
#= image("arrow.files/arrow-3.png")

#% section
# See also

#% text
# `line`, `text`, `thickness`, `graphics`
