#! mathcas 2 notebook

#% title
# contours

#% text
# `contours` is an option of `contour_plot`: `contours: n` draws `n` levels evenly between the least and the greatest value, `contours: [c1, c2, ...]` the given levels.

#% section
# Details

#% item
# The default is 10 levels.

#% section
# Examples

#% subsection
# Basic examples

#% cell
contour_plot(x^2 + y^2, [x, -1, 1], [y, -1, 1], contours: 5)
#% output
#= image("contours.files/contours-1.svgz")

#% cell
contour_plot(x^2 + y^2, [x, -1, 1], [y, -1, 1], contours: [0.25, 0.5, 1])
#% output
#= image("contours.files/contours-2.svgz")

#% cell
contour_plot(sin(x)*sin(y), [x, 0, 6], [y, 0, 6], contours: 20)
#% output
#= image("contours.files/contours-3.svgz")

#% section
# See also

#% text
# `contour_plot`, `color_function`, `plot_points`
