#! mathcas 2 notebook

#% title
# number_compose

#% text
# `number_compose(digits, bases)` gives the sum of `digits[i]*bases[i]`, for example a time in seconds from days, hours, minutes and seconds.

#% section
# Examples

#% subsection
# Basic examples

#% cell
number_compose([1, 3, 22, 14], [86400, 3600, 60, 1])
#% output
#= 98534

#% cell
number_compose([5, 1, 2, 1.32], [10, 5, 2, 1])
#% output
#= 60.32

#% cell
number_compose([1, pi, e], [5, 2, 1])
#% output
#= 5 + e + 2*pi

#% section
# See also

#% text
# `number_expand`, `from_digits`, `mixed_radix`
