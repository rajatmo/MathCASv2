#! mathcas 2 notebook

#% title
# legend

#% text
# `legend` is an option of graphics and plots. In plots it is a list of strings, one per curve; in graphics each entry is a label, `[directives, label]` (a line sample) or `[directives, label, line | point | swatch | none]`.

#% section
# Examples

#% subsection
# Basic examples

#% cell
plot([sin(x), cos(x)], [x, 0, 2pi], legend: ["sin", "cos"])
#% output
#= image("legend.files/legend-1.png")

#% cell
plot([x, x^2, x^3], [x, 0, 1], legend: [r"$x$", r"$x^2$", r"$x^3$"])
#% output
#= image("legend.files/legend-2.png")

#% subsection
# Scope

#% text
# In a graphic:

#% cell
graphics([red, disk()], legend: [[red, "disk", swatch]])
#% output
#= image("legend.files/legend-3.png")

#% section
# See also

#% text
# `legend_position`, `legend_layout`, `legend_frame`, `line_legend`
