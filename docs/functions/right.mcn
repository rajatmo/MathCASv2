#! mathcas 2 notebook

#% title
# right

#% text
# `right` is the right side: a position for `placed`, for the label of `labeled` and for the corner of a placed legend.

#% section
# Details

#% item
# `placed(obj, right)` puts `obj` to the right of the plot area; `labeled(g, label, right)` puts the label to the right of the graphic.

#% item
# In `plot_legends: placed(entries, right)` the legend goes to the nearest corner of the plot.

#% section
# Examples

#% subsection
# Basic examples

#% cell
graphics([circle(), placed("label", right)])
#% output
#= image("right.files/right-1.svgz")

#% cell
labeled(graphics([blue, disk()], image_size: 120), "a disk", right)
#% output
#= image("right.files/right-2.svgz")

#% cell
plot([sin(x), cos(x)], [x, 0, 2*pi], plot_legends: placed(["sin", "cos"], right))
#% output
#= image("right.files/right-3.svgz")

#% section
# See also

#% text
# `placed`, `labeled`, `left`, `above`, `below`, `after`
