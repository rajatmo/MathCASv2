#! mathcas 2 notebook

#% title
# scaling_matrix

#% text
# `scaling_matrix([s1, ..., sn])` gives the diagonal matrix that scales the coordinates by the factors `s1`, ..., `sn`.

#% section
# Details

#% item
# `scaling_matrix(s, v)` scales by `s` along the direction `v` and leaves the perpendicular directions alone.

#% item
# `scaling_matrix([s1, ...], [v1, ...])` scales along several directions.

#% section
# Examples

#% subsection
# Basic examples

#% cell
scaling_matrix([a, b, c])
#% output
#= [[a, 0, 0], [0, b, 0], [0, 0, c]]

#% cell
scaling_matrix(s, [1, -1])
#% output
#= [[(1/2)*(1 + s), (-1/2)*(-1 + s)], [(-1/2)*(-1 + s), (1/2)*(1 + s)]]

#% cell
together(dot(scaling_matrix(s, [1, -1]), [1, -1]))
#% output
#= [s, -s]

#% cell
scaling_matrix([2, 3], [[1, 0], [0, 1]])
#% output
#= [[2, 0], [0, 3]]

#% section
# See also

#% text
# `shearing_matrix`, `diagonal_matrix`, `rotation_matrix`
