#! mathcas 2 notebook

#% title
# permutation_power

#% text
# `permutation_power(p, k)`: the k-th power of the permutation (k may be negative)

#% section
# Examples

#% subsection
# Basic examples

#% cell
permutation_power(cycles([[1, 2, 3, 4, 5, 6]]), 2)
#% output
#= cycles([[1, 3, 5], [2, 4, 6]])

#% cell
permutation_power(cycles([[1, 2, 3, 4, 5, 6]]), -1)
#% output
#= cycles([[1, 6, 5, 4, 3, 2]])

#% cell
permutation_power(cycles([[1, 2, 3]]), 3)
#% output
#= cycles([])

