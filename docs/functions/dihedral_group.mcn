#! mathcas 2 notebook

#% title
# dihedral_group

#% text
# `dihedral_group(k)`: the dihedral group of order 2 k, the symmetries of a k-gon

#% section
# Details

#% item
# `dihedral_group(1)` is the group of order 2 on 2 points and `dihedral_group(2)` the Klein four-group on 4 points.

#% section
# Examples

#% subsection
# Basic examples

#% cell
dihedral_group(5)
#% output
#= permutation_group([cycles([[1, 2, 3, 4, 5]]), cycles([[2, 5], [3, 4]])])

#% cell
group_order(dihedral_group(5))
#% output
#= 10

#% cell
group_orbits(dihedral_group(2))
#% output
#= [[1, 2, 3, 4]]

