#! mathcas 2 notebook

#% title
# append

#% text
# `append(xs, x)` gives the list `xs` with `x` added at the end.

#% section
# Details

#% item
# The list itself is not changed: `append` gives a new list. Assign the result to keep it.

#% item
# A list `x` is added as one element; to join the elements of two lists, use `join`.

#% section
# Examples

#% subsection
# Basic examples

#% cell
append([a, b], c)
#% output
#= [a, b, c]

#% cell
append([], 1)
#% output
#= [1]

#% cell
append([1, 2], [3, 4])
#% output
#= [1, 2, [3, 4]]

#% subsection
# Scope

#% text
# Any compound term:

#% cell
append(f(a), b)
#% output
#= f(a, b)

#% subsection
# Applications

#% text
# Building a list in a loop:

#% cell
{
  var xs = []
  for k in range(5) { xs = append(xs, k^2) }
  xs
}
#% output
#= [1, 4, 9, 16, 25]

#% text
# Adding a reference line to a list of curves before plotting, as the reheating script does with the line 1:

#% cell
curves = [x, x^2]
append(curves, 1)
#% output
#= [x, x^2, 1]

#% subsection
# Properties and relations

#% text
# `prepend` adds at the start, `join` concatenates:

#% cell
[append([1, 2], 3), prepend([1, 2], 0), join([1, 2], [3])]
#% output
#= [[1, 2, 3], [0, 1, 2], [1, 2, 3]]

#% text
# The original list is unchanged:

#% cell
ys = [1, 2]; append(ys, 3); ys
#% output
#= [1, 2]

#% section
# See also

#% text
# `prepend`, `join`, `insert`, `riffle`
