#% title
# from_characters

#% text
# `from_characters([c1, c2, ...])` gives the string made of a list of one-character strings.

#% section
# Examples

#% subsection
# Basic examples

#% cell
from_characters(["a", "b", "c"])
#% output
#= "abc"

#% cell
from_characters(reverse(characters("stressed")))
#% output
#= "desserts"

