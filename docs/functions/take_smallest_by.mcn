#! mathcas 2 notebook

#% title
# take_smallest_by

#% text
# `take_smallest_by(xs, f, n)` gives the `n` elements of `xs` with the smallest values of `f(x)`, smallest first.

#% section
# Details

#% item
# Values are compared numerically; equal values keep their order.

#% item
# `n` may be `up_to(n)`; an association keeps the chosen entries.

#% section
# Examples

#% subsection
# Basic examples

#% cell
take_smallest_by([-5, -2, 4, 3, 1, 9, 2, -4], abs, 3)
#% output
#= [1, -2, 2]

#% cell
take_smallest_by(["aaa", "a", "aa"], string_length, 2)
#% output
#= ["a", "aa"]

#% cell
take_smallest_by([3, 1], abs, up_to(5))
#% output
#= [1, 3]

#% subsection
# Scope

#% cell
take_smallest_by(assoc(a -> 5, b -> -1, c -> 2), abs, 2)
#% output
#= assoc(b -> -1, c -> 2)

#% cell
take_smallest_by(abs, 1)([-3, 2])
#% output
#= [2]

#% section
# See also

#% text
# `take_largest_by`, `take_smallest`, `min_by`, `sort_by`
