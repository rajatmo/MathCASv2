#! mathcas 2 notebook

#% title
# is_string_match

#% text
# `is_string_match(s, p)` gives `true` when the whole of `s` matches the string pattern `p`. In a literal string pattern, `*` stands for any run of characters and `@` for a run of characters that are not capital letters.

#% section
# Examples

#% subsection
# Basic examples

#% cell
is_string_match("apppbb", string_expression("a", ___, "b"))
#% output
#= true

#% cell
is_string_match("2024-11-05", regular_expression("\\d{4}-\\d{2}-\\d{2}"))
#% output
#= true

#% cell
is_string_match(["apple", "banana"], "a*")
#% output
#= [true, false]

#% cell
is_string_match("Apple", "a*", ignore_case: true)
#% output
#= true

#% section
# See also

#% text
# `is_string_free`, `string_contains`, `string_cases`
