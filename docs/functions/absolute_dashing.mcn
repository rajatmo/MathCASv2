#! mathcas 2 notebook

#% title
# absolute_dashing

#% text
# `absolute_dashing([d1, d2, ...])` is a graphics directive: lines that follow are drawn with dashes and gaps of d1, d2, ... points, repeated.

#% section
# Details

#% item
# The pattern does not change with the size of the graphic; `dashing` is relative to the plot width.

#% item
# Named patterns in `dashing` are in points too, made for lines 2 points wide.

#% section
# Examples

#% subsection
# Basic examples

#% text
# Dashes of 8 points with gaps of 4:

#% cell
graphics([absolute_dashing([8, 4]), line([[0, 0], [5, 0]])])
#% output
#= image("absolute_dashing.files/absolute_dashing-1.svgz")

#% text
# A dash-dot edge around a square:

#% cell
graphics([face_form(none), edge_form([black, absolute_dashing([6, 3, 1, 3])]), rectangle()])
#% output
#= image("absolute_dashing.files/absolute_dashing-2.svgz")

#% section
# See also

#% text
# `dashing`, `absolute_thickness`, `edge_form`
