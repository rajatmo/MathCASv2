#! mathcas 2 notebook

#% title
# list_step_plot

#% text
# `list_step_plot(data)` draws a step function that holds each value until the next point.

#% section
# Details

#% item
# `list_step_plot(data, right)` or `center` aligns the steps otherwise.

#% section
# Examples

#% subsection
# Basic examples

#% cell
list_step_plot([1, 3, 2, 4])
#% output
#= image("list_step_plot.files/list_step_plot-1.png")

#% cell
list_step_plot([[0, 1], [1, 3], [3, 2]], center)
#% output
#= image("list_step_plot.files/list_step_plot-2.png")

#% section
# See also

