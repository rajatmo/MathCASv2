#% title
# list_slice_density_plot3d

#% text
# `list_slice_density_plot3d(array, surface)` draws a 3D array of values (layers along z, rows along y) as colours on surfaces.

#% section
# Details

#% item
# Option `data_range: [[x0, x1], [y0, y1], [z0, z1]]`.

#% section
# Examples

#% subsection
# Basic examples

#% cell
list_slice_density_plot3d(table(x^2 + y - z, z, range(-1, 1, 0.2), y, range(-1, 1, 0.2), x, range(-1, 1, 0.2)), "CenterPlanes")
