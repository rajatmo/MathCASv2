#! mathcas 2 notebook

#% title
# group_by

#% text
# `group_by(xs, f)` gives the association from each value `f(x)` to the list of the elements `x` of `xs` that have it.

#% text
# `group_by(xs, f, g)` applies `g` to each group.

#% section
# Details

#% item
# Groups keep the order of the elements; keys are in the order of first occurrence.

#% item
# `gather_by` gives the groups as a list of lists, without the keys.

#% section
# Examples

#% subsection
# Basic examples

#% cell
group_by(range(10), k => mod(k, 3))
#% output
#= assoc(1 -> [1, 4, 7, 10], 2 -> [2, 5, 8], 0 -> [3, 6, 9])

#% cell
group_by(["apple", "avocado", "banana", "blueberry", "cherry"], s => string_take(s, 1))
#% output
#= assoc("a" -> ["apple", "avocado"], "b" -> ["banana", "blueberry"], "c" -> ["cherry"])

#% cell
group_by(range(10), is_even, total)
#% output
#= assoc(false -> 25, true -> 30)

#% subsection
# Scope

#% text
# Grouping rows of data by a column:

#% cell
rows = [["Ada", "math"], ["Ben", "physics"], ["Cy", "math"]]
group_by(rows, r => r[2], g => map(first, g))
#% output
#= assoc("math" -> ["Ada", "Cy"], "physics" -> ["Ben"])

#% subsection
# Applications

#% text
# The primes below 100 grouped by their last digit:

#% cell
group_by(select(range(100), is_prime), p => mod(p, 10), length)
#% output
#= assoc(2 -> 1, 3 -> 7, 5 -> 1, 7 -> 6, 1 -> 5, 9 -> 5)

#% text
# Measurements averaged per setting:

#% cell
data = [[1, 2.0], [2, 3.9], [1, 2.2], [2, 4.1], [3, 6.0]]
group_by(data, first, g => mean(map(last, g)))
#% output
#= assoc(1 -> 2.1, 2 -> 4.0, 3 -> 6.0)

#% subsection
# Properties and relations

#% text
# The sizes of the groups are the counts of the keys:

#% cell
xs = characters("banana")
group_by(xs, c => c, length) === counts(xs)
#% output
#= true

#% text
# `gather_by` gives the groups without keys:

#% cell
gather_by(range(10), k => mod(k, 3))
#% output
#= [[1, 4, 7, 10], [2, 5, 8], [3, 6, 9]]

#% section
# See also

#% text
# `gather_by`, `counts`, `tally`, `assoc`, `select`
