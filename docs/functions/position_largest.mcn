#! mathcas 2 notebook

#% title
# position_largest

#% text
# `position_largest(xs)` gives the positions of the largest elements of `xs` in numerical order.

#% section
# Details

#% item
# Every position with the largest value is given, each as a list `[i]`.

#% section
# Examples

#% subsection
# Basic examples

#% cell
position_largest([1, 3, 2])
#% output
#= [[2]]

#% cell
position_largest([1, 3, 3])
#% output
#= [[2], [3]]

#% cell
position_largest([pi, e, 3])
#% output
#= position_largest([pi, e, 3])

#% subsection
# Scope

#% cell
position_largest([-1.5, -0.5, -2])
#% output
#= [[2]]

#% cell
position_largest([])
#% output
#= []

#% section
# See also

#% text
# `position_smallest`, `max`, `ordering`, `take_largest`
