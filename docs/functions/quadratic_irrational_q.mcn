#! mathcas 2 notebook

#% title
# quadratic_irrational_q

#% text
# `quadratic_irrational_q(x)` gives `true` if `x` is an irrational root of a quadratic polynomial with integer coefficients.

#% section
# Details

#% item
# Rationals, inexact numbers, transcendental numbers and symbols give `false`.

#% item
# The function maps over lists.

#% section
# Examples

#% subsection
# Basic examples

#% cell
quadratic_irrational_q(sqrt(2) + 1)
#% output
#= true

#% cell
quadratic_irrational_q(sqrt(2) + sqrt(3))
#% output
#= false

#% cell
quadratic_irrational_q([3/2, pi, sqrt(3), (1 + sqrt(5))/2])
#% output
#= [false, false, true, true]

#% cell
quadratic_irrational_q(s)
#% output
#= false

#% section
# See also

#% text
