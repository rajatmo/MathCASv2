#! mathcas 2 notebook

#% title
# white

#% text
# `white` is the colour white, a directive for graphics and a value for plot options such as `colors:`.

#% section
# Examples

#% subsection
# Basic examples

#% cell
graphics([white, disk()])
#% output
#= image("white.files/white-1.svgz")

#% cell
plot(sin(x), [x, 0, 2pi], colors: [white])
#% output
#= image("white.files/white-2.svgz")

#% subsection
# Scope

#% text
# Lighter and darker shades:

#% cell
graphics([[lighter(white), disk([0, 0])], [white, disk([2, 0])], [darker(white), disk([4, 0])]])
#% output
#= image("white.files/white-3.svgz")

#% section
# See also

#% text
# `black`, `gray`, `background`
