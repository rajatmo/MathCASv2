#! mathcas 2 notebook

#% title
# mesh_cell_count

#% text
# `mesh_cell_count(m)`: the number of cells of each dimension of a mesh region; mesh_cell_count(m, d) of dimension d

#% section
# Examples

#% subsection
# Basic examples

#% cell
m = mesh_region([[0, 0, 0], [2, 0, 0], [2, 2, 0], [0, 2, 0], [1, 1, 2]], tetrahedron([[1, 2, 3, 5], [1, 3, 4, 5]]))

#% cell
mesh_cell_count(m)
#% output
#= [5, 9, 7, 2]

#% cell
mesh_cell_count(m, 2)
#% output
#= 7

