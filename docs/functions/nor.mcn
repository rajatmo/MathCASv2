#! mathcas 2 notebook

#% title
# nor

#% text
# `nor(a, b, ...)` is `not (a or b or ...)`.

#% section
# Details

#% item
# Arguments `false` are dropped; an argument `true` gives `false`; `nor()` is `true` and `nor(a)` is `not a`.

#% item
# Symbolic arguments otherwise stay.

#% section
# Examples

#% subsection
# Basic examples

#% cell
nor(true, false)
#% output
#= false

#% cell
nor(x, false, z)
#% output
#= nor(x, z)

#% cell
nor(x, true, z)
#% output
#= false

#% cell
nor()
#% output
#= true

#% section
# See also

#% text
# `nand`, `or`, `not`, `xor`
