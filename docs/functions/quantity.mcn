#! mathcas 2 notebook

#% title
# quantity

#% text
# `quantity(m, unit)` represents the magnitude `m` in a unit.

#% text
# `quantity(unit)` represents one unit.

#% section
# Details

#% item
# Units are strings such as `"Meters"`, `"Feet"`, `"Seconds"`, `"Kilograms"`, `"Newtons"`, and products and powers of them.

#% item
# Sums convert to the smallest of their units; products and powers multiply magnitudes and units; units that cancel give a number.

#% item
# Adding quantities of different dimensions gives `failure(incompatible_units)`.

#% section
# Examples

#% subsection
# Basic examples

#% cell
quantity(3, "Meters") + quantity(2, "Feet")
#% output
#= quantity(1504/127, "Feet")

#% cell
quantity(6, "Meters")/quantity(2, "Seconds")
#% output
#= quantity(3, "Meters"/"Seconds")

#% cell
quantity(2, "Meters")^2
#% output
#= quantity(4, "Meters"^2)

#% subsection
# Scope

#% cell
quantity(3, "Meters")/quantity(2, "Meters")
#% output
#= 3/2

#% cell
2*quantity(1.5, "Grams")
#% output
#= quantity(3.0, "Grams")

#% subsection
# Properties and relations

#% text
# Comparisons convert to a common unit:

#% cell
quantity(3, "Feet") < quantity(1.1, "Meters")
#% output
#= true

#% text
# Functions of the magnitude keep the unit, and roots of units simplify:

#% cell
sqrt(quantity(16, "Meters"^2))
#% output
#= quantity(4, "Meters")

#% cell
round(quantity(377, "Centimeters"), quantity(1, "Meters"))
#% output
#= quantity(400, "Centimeters")

#% text
# Statistics of quantities are in their unit:

#% cell
mean([quantity(1, "Meters"), quantity(300, "Centimeters")])
#% output
#= quantity(2, "Meters")

#% cell
norm([quantity(3, "Meters"), quantity(4, "Meters")])
#% output
#= quantity(5, "Meters")

#% text
# A list of magnitudes gives a list of quantities:

#% cell
quantity([1, 2, 3], "Seconds")
#% output
#= [quantity(1, "Seconds"), quantity(2, "Seconds"), quantity(3, "Seconds")]

#% subsection
# Possible issues

#% cell
quantity(3, "Meters") + quantity(1, "Seconds")
#% output
#! failure(incompatible_units)

#% section
# See also

#% text
# `unit_convert`, `quantity_magnitude`, `quantity_unit`
