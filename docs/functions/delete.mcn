#! mathcas 2 notebook

#% title
# delete

#% text
# `delete(x, pos)` gives `x` without the part at the position `pos`.

#% text
# `delete(x, [pos1, pos2, ...])` removes the parts at several positions.

#% section
# Details

#% item
# Positions refer to `x` before anything is removed; negative indices count from the end.

#% item
# The result is evaluated with its remaining parts.

#% section
# Examples

#% subsection
# Basic examples

#% cell
delete([a, b, c, d], 2)
#% output
#= [a, c, d]

#% cell
delete([a, b, c, d], [[1], [-1]])
#% output
#= [b, c]

#% subsection
# Scope

#% text
# Deeper positions:

#% cell
delete([[a, b], [c, d]], [2, 1])
#% output
#= [[a, b], [d]]

#% subsection
# Properties and relations

#% text
# `drop` removes runs from the ends; `delete` any positions:

#% cell
delete(range(6), [[2], [4], [6]]) == select(range(6), is_odd)
#% output
#= true

#% section
# See also

#% text
# `drop`, `delete_cases`, `replace_part`, `extract`
