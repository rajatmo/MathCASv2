#! mathcas 2 notebook

#% title
# map_all

#% text
# `map_all(f, x)` applies `f` to every part of `x`, innermost parts first.

#% section
# Details

#% item
# Atoms are included; heads are not.

#% item
# The result is evaluated after the whole tree is built.

#% section
# Examples

#% subsection
# Basic examples

#% cell
map_all(f, [[a, b], [c, d]])
#% output
#= f([f([f(a), f(b)]), f([f(c), f(d)])])

#% cell
map_all(f, g(x, h(y)))
#% output
#= f(g(f(x), f(h(f(y)))))

#% cell
map_all(x => x, [1, [2, 3]])
#% output
#= [1, [2, 3]]

#% subsection
# Scope

#% cell
map_all(f, assoc(a -> 1))
#% output
#= f(assoc(f(f(a) -> f(1))))

#% cell
map_all(abs, [-1, [-2, 3]])
#% output
#= [1, [2, 3]]

#% section
# See also

#% text
# `map`, `map_at`, `rewrite`
