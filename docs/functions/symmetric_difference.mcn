#! mathcas 2 notebook

#% title
# symmetric_difference

#% text
# `symmetric_difference(xs, ys, ...)` gives the sorted distinct elements that occur in an odd number of the lists.

#% section
# Details

#% item
# With two lists: the elements in exactly one of them.

#% section
# Examples

#% subsection
# Basic examples

#% cell
symmetric_difference([1, 2, 3], [2, 4])
#% output
#= [1, 3, 4]

#% cell
symmetric_difference([a, b], [b, c], [c, d])
#% output
#= [a, d]

#% cell
symmetric_difference([1, 1], [1])
#% output
#= []

#% subsection
# Scope

#% cell
symmetric_difference([1, 2], [1, 2])
#% output
#= []

#% cell
symmetric_difference(characters("abc"), characters("bcd"))
#% output
#= ["a", "d"]

#% section
# See also

#% text
# `union`, `intersection`, `complement`
