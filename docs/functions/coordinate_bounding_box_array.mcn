#! mathcas 2 notebook

#% title
# coordinate_bounding_box_array

#% text
# `coordinate_bounding_box_array([[a1, a2, ...], [b1, b2, ...]], ...)` gives `coordinate_bounds_array` of the box with those corners.

#% section
# Details

#% item
# The further arguments are those of `coordinate_bounds_array`.

#% section
# Examples

#% subsection
# Basic examples

#% cell
coordinate_bounding_box_array([[3, -1], [5, 1]])
#% output
#= [[[3, -1], [3, 0], [3, 1]], [[4, -1], [4, 0], [4, 1]], [[5, -1], [5, 0], [5, 1]]]

#% cell
coordinate_bounding_box_array([[3, -1], [8, 2]], [into(3), into(2)])
#% output
#= [[[3, -1], [3, 1/2], [3, 2]], [[14/3, -1], [14/3, 1/2], [14/3, 2]], [[19/3, -1], [19/3, 1/2], [19/3, 2]], [[8, -1], [8, 1/2], [8, 2]]]

#% section
# See also

#% text
# `coordinate_bounds_array`, `coordinate_bounding_box`
