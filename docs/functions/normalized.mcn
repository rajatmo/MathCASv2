#! mathcas 2 notebook

#% title
# normalized

#% text
# `normalized` is an option of `histogram`: `normalized: true` scales the bars so that their total area is 1, a probability density.

#% section
# Details

#% item
# The default is `false`: the bar heights are the counts.

#% section
# Examples

#% subsection
# Basic examples

#% cell
seed(3); data = random_variate(normal_distribution(0, 1), 1000); histogram(data, normalized: true)
#% output
#= image("normalized.files/normalized-1.svgz")

#% cell
histogram(data, normalized: false)
#% output
#= image("normalized.files/normalized-2.svgz")

#% cell
histogram(data, bins: [0.5], normalized: true)
#% output
#= image("normalized.files/normalized-3.svgz")

#% subsection
# Applications

#% text
# The density estimate beside the true density:

#% cell
show(histogram(data, normalized: true), plot(pdf(normal_distribution(0, 1), x), [x, -4, 4]))
#% output
#= image("normalized.files/normalized-4.svgz")

#% section
# See also

#% text
# `histogram`, `bins`, `pdf`
