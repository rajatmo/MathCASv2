#! mathcas 2 notebook

#% title
# hook_lengths

#% text
# `hook_lengths(shape)`: the hook length of each cell of the Young diagram

#% section
# Details

#% item
# The hook of a cell is the cell, the cells to its right and the cells below it.

#% section
# Examples

#% subsection
# Basic examples

#% cell
hook_lengths([3, 2])
#% output
#= [[4, 3, 1], [2, 1]]

#% cell
hook_lengths([4, 3, 1])
#% output
#= [[6, 4, 3, 1], [4, 2, 1], [1]]

