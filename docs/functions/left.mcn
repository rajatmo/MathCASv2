#! mathcas 2 notebook

#% title
# left

#% text
# `left` is the left side: a position for `placed`, for the label of `labeled` and for the corner of a placed legend.

#% section
# Details

#% item
# `placed(obj, left)` puts `obj` to the left of the plot area; `labeled(g, label, left)` puts the label to the left of the graphic.

#% item
# In `plot_legends: placed(entries, left)` the legend goes to the nearest corner of the plot.

#% section
# Examples

#% subsection
# Basic examples

#% cell
graphics([circle(), placed("label", left)])
#% output
#= image("left.files/left-1.svgz")

#% cell
labeled(graphics([blue, disk()], image_size: 120), "a disk", left)
#% output
#= image("left.files/left-2.svgz")

#% cell
plot([sin(x), cos(x)], [x, 0, 2*pi], plot_legends: placed(["sin", "cos"], left))
#% output
#= image("left.files/left-3.svgz")

#% section
# See also

#% text
# `placed`, `labeled`, `right`, `above`, `below`, `before`
