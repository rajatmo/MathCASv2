#! mathcas 2 notebook

#% title
# tube

#% text
# `tube([p1, p2, ...], r)` is a tube of radius r along the path through the points, in `graphics3d`; r is 0.05 by default.

#% section
# Details

#% item
# Coordinates are in the units of the graphic; the box around the scene follows the data unless `plot_range` says otherwise.

#% item
# Colours, `opacity` and `edge_form` before it in its list style it; faces are lit.

#% section
# Examples

#% subsection
# Basic examples

#% text
# The default:

#% cell
graphics3d(tube([[0, 0, 0], [1, 0, 1], [2, 1, 1]], 0.1))
#% output
#= image("tube.files/tube-1.svgz")

#% subsection
# Scope

#% text
# A helix as a tube:

#% cell
graphics3d(tube(table([cos(t), sin(t), t/6], t, range(0, 12, 0.2)), 0.08))
#% output
#= image("tube.files/tube-2.svgz")

#% subsection
# Applications

#% text
# A thin and a thick tube:

#% cell
graphics3d([tube([[0, 0, 0], [1, 1, 1]]), red, tube([[1, 0, 0], [0, 1, 1]], 0.2)])
#% output
#= image("tube.files/tube-3.svgz")

#% section
# See also

#% text
# `graphics3d`, `sphere`, `plot3d`
