#! mathcas 2 notebook

#% title
# is_upper_triangular_matrix

#% text
# `is_upper_triangular_matrix(m)` is true when every entry of `m` below the main diagonal is zero; `is_upper_triangular_matrix(m, k)` when every entry below the `k`-th diagonal is.

#% section
# Details

#% item
# The result is false for anything that is not a matrix.

#% item
# Entries are compared with zero by `==`.

#% section
# Examples

#% subsection
# Basic examples

#% cell
is_upper_triangular_matrix([[1, 2], [0, 3]])
#% output
#= true

#% cell
is_upper_triangular_matrix([[1, 2], [4, 3]])
#% output
#= false

#% cell
is_upper_triangular_matrix([[1, 2], [4, 3]], -1)
#% output
#= true

#% cell
is_upper_triangular_matrix(identity_matrix(3))
#% output
#= true

#% section
# See also

#% text
