#! mathcas 2 notebook

#% title
# is_conjugate

#% text
# `is_conjugate(G, a, b)`: whether b = g^-1 a g for some g in G

#% section
# Examples

#% subsection
# Basic examples

#% cell
is_conjugate(symmetric_group(5), cycles([[1, 2, 3]]), cycles([[2, 4, 5]]))
#% output
#= true

#% cell
is_conjugate(alternating_group(5), cycles([[1, 2, 3, 4, 5]]), cycles([[1, 3, 5, 2, 4]]))
#% output
#= false

