#% title
# highlight_mesh

#% text
# `highlight_mesh(m, style(d, directives...), ...)`: the mesh region m shown with its cells of dimension d drawn with the directives (`d` alone: red)

#% section
# Examples

#% subsection
# Basic examples

#% cell
m = mesh_region([[0, 0], [1, 0], [1, 1], [0, 1]], polygon([1, 2, 3, 4]))

#% cell
highlight_mesh(m, style(0, red), style(1, blue))
