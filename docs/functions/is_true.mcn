#! mathcas 2 notebook

#% title
# is_true

#% text
# `is_true(x)` gives `true` when `x` is `true` and `false` for anything else.

#% section
# Details

#% item
# Unlike a condition, it never stays unevaluated.

#% section
# Examples

#% subsection
# Basic examples

#% cell
is_true(true)
#% output
#= true

#% cell
is_true(false)
#% output
#= false

#% cell
is_true(x)
#% output
#= false

#% subsection
# Scope

#% cell
is_true(1 < 2)
#% output
#= true

#% cell
map(is_true, [true, 1, "true"])
#% output
#= [true, false, false]

#% section
# See also

#% text
# `same`, `xor`
