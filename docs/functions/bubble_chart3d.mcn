#% title
# bubble_chart3d

#% text
# `bubble_chart3d([[x, y, z, s], ...])` draws spheres at the points `[x, y, z, s]` with volumes in proportion to `s`.

#% section
# Examples

#% subsection
# Basic examples

#% cell
bubble_chart3d([[1, 2, 3, 1], [2, 1, 1, 2], [1, 1, 2, 3], [3, 3, 1, 1]])
