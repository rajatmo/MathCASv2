#! mathcas 2 notebook

#% title
# outer

#% text
# `outer(f, xs, ys, ...)` gives the nested lists of `f(x, y, ...)` for every choice of `x` from `xs`, `y` from `ys`, and so on.

#% section
# Examples

#% subsection
# Basic examples

#% cell
outer(f, [a, b], [1, 2, 3])
#% output
#= [[f(a, 1), f(a, 2), f(a, 3)], [f(b, 1), f(b, 2), f(b, 3)]]

#% cell
outer(mul, range(3), range(4))
#% output
#= [[1, 2, 3, 4], [2, 4, 6, 8], [3, 6, 9, 12]]

#% subsection
# Scope

#% text
# An outer product of vectors is a matrix:

#% cell
outer(mul, [1, 2], [x, y])
#% output
#= [[x, y], [2*x, 2*y]]

#% text
# Three lists give a three-level array:

#% cell
dimensions(outer(add, [1, 2], [3, 4, 5], [6, 7]))
#% output
#= [2, 3, 2]

#% section
# See also

#% text
# `tuples`, `inner`, `table`, `kronecker_product`
