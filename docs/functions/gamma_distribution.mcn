#! mathcas 2 notebook

#% title
# gamma_distribution

#% text
# `gamma_distribution(k, theta)` is the gamma distribution with shape `k > 0` and scale `theta > 0`; its mean is `k theta`.

#% section
# Examples

#% subsection
# Basic examples

#% cell
pdf(gamma_distribution(k, theta), x)
#% output
#= piecewise([[exp(-x/theta)*theta^-k*x^(-1 + k)/gamma(k), x > 0]], 0)

#% cell
mean(gamma_distribution(k, theta))
#% output
#= k*theta

#% cell
variance(gamma_distribution(k, theta))
#% output
#= k*theta^2

#% subsection
# Scope

#% text
# Shape 1 gives the exponential distribution with rate `1/theta`:

#% cell
pdf(gamma_distribution(1, theta), 2)
#% output
#= exp(-2/theta)/theta

#% text
# Draws from it have the expected mean:

#% cell
seed(3); mean(random_variate(gamma_distribution(3, 2), 100000))
#% output
#= 6.016123820670194

#% section
# See also

#% text
# `exponential_distribution`, `chi_square_distribution`, `gamma`
