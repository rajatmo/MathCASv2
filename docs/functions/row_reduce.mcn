#! mathcas 2 notebook

#% title
# row_reduce

#% text
# `row_reduce(m)` gives the reduced row echelon form of the matrix `m`.

#% section
# Details

#% item
# Each nonzero row starts with a 1 in a column where all other entries are 0; zero rows come last.

#% item
# Exact matrices are reduced exactly; machine matrices with partial pivoting.

#% section
# Examples

#% subsection
# Basic examples

#% cell
row_reduce([[1, 2], [3, 4]])
#% output
#= [[1, 0], [0, 1]]

#% cell
row_reduce([[1, 2, 3], [4, 5, 6], [7, 8, 9]])
#% output
#= [[1, 0, -1], [0, 1, 2], [0, 0, 0]]

#% cell
row_reduce([[2, 4, 6, 8], [1, 3, 5, 7]])
#% output
#= [[1, 0, -1, -2], [0, 1, 2, 3]]

#% subsection
# Applications

#% text
# Solving a linear system from its augmented matrix:

#% cell
row_reduce([[1, 1, 1, 6], [1, -1, 2, 5], [2, 1, -1, 1]])
#% output
#= [[1, 0, 0, 1], [0, 1, 0, 2], [0, 0, 1, 3]]

#% subsection
# Properties and relations

#% text
# The number of nonzero rows is the rank:

#% cell
m = [[1, 2, 1], [2, 4, 2], [0, 1, 1]]; [count_if(row_reduce(m), r => r != [0, 0, 0]), rank(m)]
#% output
#= [2, 2]

#% section
# See also

#% text
# `rank`, `null_space`, `linear_solve`, `inverse`
