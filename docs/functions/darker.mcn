#! mathcas 2 notebook

#% title
# darker

#% text
# `darker(c)` gives the colour c a third of the way to black.

#% text
# `darker(c, f)` gives c a fraction f of the way to black, f between 0 and 1.

#% section
# Details

#% item
# The opacity of c is kept.

#% section
# Examples

#% subsection
# Basic examples

#% text
# A darker yellow:

#% cell
darker(yellow)
#% output
#= rgb_color(0.6666666666666667, 0.6666666666666667, 0.0)

#% text
# White half way to black:

#% cell
darker(white, 0.5)
#% output
#= rgb_color(0.5, 0.5, 0.5)

#% subsection
# Applications

#% text
# Shades of one colour:

#% cell
graphics(table([darker(orange, k/4), disk([k, 0], 0.45)], k, range(0, 3)))
#% output
#= image("darker.files/darker-3.png")

#% section
# See also

#% text
# `lighter`, `blend`
