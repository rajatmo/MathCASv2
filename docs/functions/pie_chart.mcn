#! mathcas 2 notebook

#% title
# pie_chart

#% text
# `pie_chart([v1, v2, ...])` draws a disk cut into sectors in proportion to the values, anticlockwise from the right, in the plot colours.

#% section
# Details

#% item
# The values must be at least 0, and not all 0.

#% item
# Options: `chart_labels` (or `labels`) beside the sectors, `legend`.

#% section
# Examples

#% subsection
# Basic examples

#% text
# Three parts:

#% cell
pie_chart([1, 2, 3])
#% output
#= image("pie_chart.files/pie_chart-1.svgz")

#% subsection
# Options

#% text
# Labels and a legend:

#% cell
pie_chart([30, 50, 20], chart_labels: ["a", "b", "c"], legend: ["alpha", "beta", "gamma"])
#% output
#= image("pie_chart.files/pie_chart-2.svgz")

#% subsection
# Properties and relations

#% text
# An association: the keys label the sectors:

#% cell
pie_chart(assoc("rent" -> 40, "food" -> 25, "travel" -> 15, "other" -> 20))
#% output
#= image("pie_chart.files/pie_chart-3.svgz")

#% text
# `legended` values make the legend; several lists are rings, the first innermost:

#% cell
pie_chart([[1, 2, 3], [legended(2, "two"), legended(2, "also two"), 1]])
#% output
#= image("pie_chart.files/pie_chart-4.svgz")

#% subsection
# Possible issues

#% text
# Negative values are refused:

#% cell
pie_chart([1, -1])
#% output
#= image("pie_chart.files/pie_chart-5.svgz")

#% section
# See also

#% text
# `bar_chart`, `histogram`
