#! mathcas 2 notebook

#% title
# hermitian_matrix_q

#% text
# `hermitian_matrix_q(m)` gives true when the square matrix m equals its conjugate transpose.

#% section
# Details

#% item
# Inexact entries compare up to rounding relative to the largest entry.

#% section
# Examples

#% subsection
# Basic examples

#% cell
hermitian_matrix_q([[1, 2 + im], [2 - im, 3]])
#% output
#= true

#% cell
hermitian_matrix_q([[1, 2], [3, 4]])
#% output
#= false

#% cell
hermitian_matrix_q(pauli_matrix(2))
#% output
#= true

#% cell
hermitian_matrix_q([[1., 0.3*im], [-0.3*im, 2.]])
#% output
#= true

#% section
# See also

#% text
# `symmetric_matrix_q`, `positive_definite_matrix_q`
