#! mathcas 2 notebook

#% title
# leaf_count

#% text
# `leaf_count(t)` gives the number of atoms in `t`, heads included.

#% section
# Examples

#% subsection
# Basic examples

#% cell
leaf_count(x)
#% output
#= 1

#% cell
leaf_count(f(x, y))
#% output
#= 3

#% cell
leaf_count(1 + x^2)
#% output
#= 5

#% subsection
# Scope

#% text
# A measure of size when comparing forms:

#% cell
leaf_count(expand((1 + x)^4)) > leaf_count((1 + x)^4)
#% output
#= true

#% section
# See also

#% text
# `depth`, `simplify`, `length`
