#! mathcas 2 notebook

#% title
# b_spline_surface

#% text
# `b_spline_surface(array)`: in graphics3d, the cubic B-spline surface with clamped ends over a grid of control points

#% section
# Examples

#% subsection
# Basic examples

#% cell
graphics3d(b_spline_surface([[[0, 0, 0], [1, 0, 1], [2, 0, 0]], [[0, 1, 1], [1, 1, 3], [2, 1, 1]], [[0, 2, 0], [1, 2, 1], [2, 2, 0]]]))
#% output
#= image("b_spline_surface.files/b_spline_surface-1.svgz")

#% subsection
# Properties and relations

#% text
# A surface of at most four control points each way is one Bezier patch: its area (by quadrature) and the least and greatest value of each coordinate

#% cell
net = [[[0, 0, 0], [1, 0, 1], [2, 0, 0]], [[0, 1, 1], [1, 1, 3], [2, 1, 1]], [[0, 2, 0], [1, 2, 1], [2, 2, 0]]]

#% cell
area(b_spline_surface(net))
#% output
#= 5.868115116499664

#% cell
region_bounds(b_spline_surface(net))
#% output
#= [[0.0, 2.0], [0.0, 2.0], [0.0, 1.25]]

