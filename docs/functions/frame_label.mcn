#! mathcas 2 notebook

#% title
# frame_label

#% text
# `frame_label` is an option of graphics and plots: `frame_label: [bottom, left]` puts labels beside the frame of a graphic or plot; the left one reads upwards.

#% section
# Examples

#% subsection
# Basic examples

#% cell
plot(x^2, [x, 0, 3], frame_label: [r"$x$", r"$x^2$"])
#% output
#= image("frame_label.files/frame_label-1.png")

#% subsection
# Scope

#% text
# Labels in a larger font with `label_style:`:

#% cell
plot(x^2, [x, 0, 3], frame_label: ["time", "distance"], label_style: font_size(14))
#% output
#= image("frame_label.files/frame_label-2.png")

#% section
# See also

#% text
# `frame`, `axes_label`, `plot_label`
