#% title
# winding_count

#% text
# `winding_count(curve, p)`: how many times a closed curve (points, a line or a polygon) turns about the point p, anticlockwise positive

#% section
# Examples

#% subsection
# Basic examples

#% cell
winding_count([[0, 0], [2, 0], [2, 2], [0, 2]], [1, 1])
#% output
#= 1

#% cell
winding_count([[0, 0], [2, 0], [2, 2], [0, 2]], [[1, 1], [3, 3]])
#% output
#= [1, 0]

