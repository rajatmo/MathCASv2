#! mathcas 2 notebook

#% title
# trace

#% text
# `trace(m)` gives the sum of the diagonal entries of the square matrix `m`.

#% section
# Details

#% item
# Entries may be exact, symbolic or numerical. The trace is the sum of the eigenvalues, counted with multiplicity.

#% section
# Examples

#% subsection
# Basic examples

#% cell
trace([[1, 2], [3, 4]])
#% output
#= 5

#% cell
trace([[a, b], [c, d]])
#% output
#= a + d

#% cell
trace(identity_matrix(5))
#% output
#= 5

#% subsection
# Properties and relations

#% text
# The trace is the sum of the eigenvalues:

#% cell
m = [[2, 1, 0], [1, 3, 1], [0, 1, 4]]; [trace(m), sum(eigenvalues(m))]
#% output
#= [9, 9]

#% text
# `trace(a.b) == trace(b.a)`:

#% cell
a = [[1, 2], [3, 4]]; b = [[0, 1], [5, 2]]; [trace(dot(a, b)), trace(dot(b, a))]
#% output
#= [21, 21]

#% section
# See also

#% text
# `det`, `eigenvalues`, `diagonal_matrix`, `identity_matrix`
