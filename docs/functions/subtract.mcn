#! mathcas 2 notebook

#% title
# subtract

#% text
# `subtract(x, y)` is `x - y`, as a function of two arguments to pass to `fold` and the like.

#% section
# Examples

#% subsection
# Basic examples

#% cell
subtract(10, 3)
#% output
#= 7

#% cell
fold(subtract, 12, [1, 2, 3])
#% output
#= 6

#% cell
map_thread(subtract, [[5, 6], [1, 2]])
#% output
#= [4, 4]

