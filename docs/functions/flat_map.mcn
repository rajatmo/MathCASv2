#! mathcas 2 notebook

#% title
# flat_map

#% text
# `flat_map(f, xs)` applies `f` to each element of `xs`, where `f` gives a list, and joins the lists into one.

#% section
# Examples

#% subsection
# Basic examples

#% cell
flat_map(k => [k, k^2], [1, 2, 3])
#% output
#= [1, 1, 2, 4, 3, 9]

#% cell
flat_map(k => range(k), [1, 2, 3])
#% output
#= [1, 1, 2, 1, 2, 3]

#% subsection
# Scope

#% text
# Elements that give an empty list disappear:

#% cell
flat_map(k => if is_even(k) then [k] else [], range(6))
#% output
#= [2, 4, 6]

#% section
# See also

#% text
# `map`, `flatten`, `join`
