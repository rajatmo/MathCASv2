#! mathcas 2 notebook

#% title
# axes

#% text
# `axes` is an option of graphics and plots: `true` draws axes through the origin with ticks, `false` none, and `[x, y]` chooses each axis.

#% section
# Examples

#% subsection
# Basic examples

#% cell
plot(x^2 - 1, [x, -2, 2], axes: true, frame: false)
#% output
#= image("axes.files/axes-1.svgz")

#% cell
graphics([disk()], axes: [true, false])
#% output
#= image("axes.files/axes-2.svgz")

#% section
# See also

#% text
# `frame`, `axes_label`, `axes_origin`, `ticks`
