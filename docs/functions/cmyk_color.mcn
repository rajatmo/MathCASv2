#% title
# cmyk_color

#% text
# `cmyk_color(c, m, y, k) or cmyk_color(c, m, y, k, a)`: a colour by cyan, magenta, yellow and black amounts in [0, 1] (shown as red (1 - c)(1 - k), ...)

#% section
# Examples

#% subsection
# Basic examples

#% cell
graphics([cmyk_color(0, 1, 1, 0.25), disk(), cmyk_color(1, 0, 0, 0), disk([2.5, 0])])
#% output
#= image("cmyk_color.files/cmyk_color-1.svgz")

