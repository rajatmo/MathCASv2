#! mathcas 2 notebook

#% title
# bottom

#% text
# `bottom` is the bottom side: a position for `placed`, for the label of `labeled` and for the corner of a placed legend.

#% section
# Details

#% item
# `placed(obj, bottom)` puts `obj` below the plot area; `labeled(g, label, bottom)` puts the label below the graphic.

#% item
# In `plot_legends: placed(entries, bottom)` the legend goes to the nearest corner of the plot.

#% item
# As a value of the option `filling`, `bottom` fills from each curve to the bottom of the plot.

#% section
# Examples

#% subsection
# Basic examples

#% cell
graphics([circle(), placed("label", bottom)])
#% output
#= image("bottom.files/bottom-1.svgz")

#% cell
labeled(graphics([blue, disk()], image_size: 120), "a disk", bottom)
#% output
#= image("bottom.files/bottom-2.svgz")

#% cell
plot([sin(x), cos(x)], [x, 0, 2*pi], plot_legends: placed(["sin", "cos"], bottom))
#% output
#= image("bottom.files/bottom-3.svgz")

#% subsection
# Scope

#% text
# The value of `filling`:

#% cell
plot(sin(x), [x, 0, 2*pi], filling: bottom)
#% output
#= image("bottom.files/bottom-4.svgz")

#% section
# See also

#% text
# `placed`, `labeled`, `left`, `right`, `above`, `below`
