#! mathcas 2 notebook

#% title
# string_count

#% text
# `string_count(s, p)` gives the number of matches of the string pattern `p` in `s`, without overlaps (`overlaps: true` counts every start).

#% section
# Examples

#% subsection
# Basic examples

#% cell
string_count("abcadcadcbaac", string_expression("a", _, "c"))
#% output
#= 4

#% cell
string_count("banana", "ana")
#% output
#= 1

#% cell
string_count("banana", "ana", overlaps: true)
#% output
#= 2

