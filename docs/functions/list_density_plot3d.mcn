#% title
# list_density_plot3d

#% text
# `list_density_plot3d(array)` draws a 3D array of values as coloured, translucent points, more opaque for larger values.

#% section
# Details

#% item
# Option `data_range`.

#% section
# Examples

#% subsection
# Basic examples

#% cell
list_density_plot3d(table(exp(-(x^2 + y^2 + z^2)), z, range(-1, 1, 0.2), y, range(-1, 1, 0.2), x, range(-1, 1, 0.2)))
