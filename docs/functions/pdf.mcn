#! mathcas 2 notebook

#% title
# pdf

#% text
# `pdf(d, x)` gives the probability density of the distribution `d` at `x`; for a discrete distribution, the probability of `x`.
# A list `x` gives a list of values.

#% section
# Examples

#% subsection
# Basic examples

#% cell
pdf(normal_distribution(0, 1), x)
#% output
#= (1/2)*2^(1/2)*exp((-1/2)*x^2)*pi^(-1/2)

#% cell
pdf(normal_distribution(0, 1), 0.5)
#% output
#= 0.35206532676429947

#% cell
pdf(poisson_distribution(2), 3)
#% output
#= (4/3)*exp(-2)

#% subsection
# Scope

#% text
# A density integrates to 1:

#% cell
integrate(pdf(exponential_distribution(3), x), [x, 0, inf])
#% output
#= 1

#% text
# Plot a density:

#% cell
plot(pdf(gamma_distribution(2, 1), x), [x, 0, 8])
#% output
#= image("pdf.files/pdf-5.png")

#% section
# See also

#% text
# `cdf`, `mean`, `random_variate`, `expectation`
