#! mathcas 2 notebook

#% title
# key_intersection

#% text
# `key_intersection([a1, a2, ...])` gives the associations restricted to the keys that all of them have.

#% section
# Details

#% item
# The order of keys of the first association is kept.

#% item
# Lists of rules are read as associations.

#% section
# Examples

#% subsection
# Basic examples

#% cell
key_intersection([assoc(a -> 1, b -> 2), assoc(b -> 3, c -> 4)])
#% output
#= [assoc(b -> 2), assoc(b -> 3)]

#% text
# No key in common:

#% cell
key_intersection([assoc(a -> 1), assoc(b -> 2)])
#% output
#= [assoc(), assoc()]

#% section
# See also

#% text
# `key_union`, `key_take`, `key_drop`
