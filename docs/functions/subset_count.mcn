#! mathcas 2 notebook

#% title
# subset_count

#% text
# `subset_count(xs, p)` gives the number of disjoint subsets of `xs`, elements in any order, that match the list pattern `p`.

#% section
# Details

#% item
# The subsets are those `subset_cases(xs, p)` gives: each element is used once; `overlaps: true` counts every subset.

#% item
# `subset_count(xs, p, n)` counts at most `n`.

#% section
# Examples

#% subsection
# Basic examples

#% cell
subset_count([a, a, b, b, b, c, c, d], [a, b, c])
#% output
#= 2

#% cell
subset_count([a, b, c, 1, 2], [_: Sym, _: Int])
#% output
#= 2

#% cell
subset_count([a, b, c, 1, 2], [_: Sym, _: Int], overlaps: true)
#% output
#= 6

#% cell
subset_count([1, 2, 3, 4, 5], [x_, y_] when x + y == 5, overlaps: true)
#% output
#= 2

#% section
# See also

#% text
# `subset_cases`, `subset_position`, `count`
