#! mathcas 2 notebook

#% title
# light_magenta

#% text
# `light_magenta` is the colour light magenta, a pale tint of `magenta`: a directive for graphics and a value for plot options such as `colors:`.

#% section
# Details

#% item
# `light_magenta` is a named colour like `magenta`; it stays a symbol until a graphic draws it.

#% item
# Pale tints suit filled areas and backgrounds behind darker curves.

#% section
# Examples

#% subsection
# Basic examples

#% cell
graphics([light_magenta, disk()])
#% output
#= image("light_magenta.files/light_magenta-1.svgz")

#% cell
plot([sin(x), cos(x)], [x, 0, 2*pi], colors: [magenta, light_magenta])
#% output
#= image("light_magenta.files/light_magenta-2.svgz")

#% cell
light_magenta
#% output
#= light_magenta

#% subsection
# Scope

#% text
# The tint beside the full colour and its darker shade:

#% cell
graphics([[light_magenta, disk([0, 0])], [magenta, disk([2, 0])], [darker(magenta), disk([4, 0])]])
#% output
#= image("light_magenta.files/light_magenta-4.svgz")

#% subsection
# Applications

#% text
# A pale band behind a curve:

#% cell
graphics([[light_magenta, rectangle([0, -1], [3, 1])], [black, line(table([t, sin(2*t)], t, range(0, 3, 0.05)))]])
#% output
#= image("light_magenta.files/light_magenta-5.svgz")

#% section
# See also

#% text
# `magenta`, `light_gray`, `lighter`, `rgb_color`, `light_blue`
