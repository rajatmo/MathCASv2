#% title
# list_surface_plot3d

#% text
# `list_surface_plot3d(grid)` draws the surface through a grid of points `[[[x, y, z], ...], ...]`.

#% section
# Details

#% item
# Scattered points are drawn as points.

#% section
# Examples

#% subsection
# Basic examples

#% cell
list_surface_plot3d(table([cos(t) * sin(p), sin(t) * sin(p), cos(p)], p, range(0, pi, pi / 12), t, range(0, 2 * pi, pi / 12)))
