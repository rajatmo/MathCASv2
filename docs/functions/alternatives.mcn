#! mathcas 2 notebook

#% title
# alternatives

#% text
# `alternatives(p1, p2, ...)` is the pattern `p1 | p2 | ...` written as a call.

#% section
# Details

#% item
# `apply(alternatives, list)` builds the pattern of any element of a list.

#% section
# Examples

#% subsection
# Basic examples

#% cell
apply(alternatives, [b, c])
#% output
#= b | c

#% cell
delete_cases([b, e, d, a, b, c, d], apply(alternatives, [b, c]))
#% output
#= [e, d, a, d]

#% cell
match_q(2, alternatives(1, 2, 3))
#% output
#= true

#% section
# See also

#% text
# `cases`, `delete_cases`, `match_q`
