#! mathcas 2 notebook

#% title
# group_elements

#% text
# `group_elements(G)`: the elements of the group, sorted

#% section
# Details

#% item
# Elements are sorted by their lists of images; at most 200000 are listed.

#% section
# Examples

#% subsection
# Basic examples

#% cell
group_elements(symmetric_group(3))
#% output
#= [cycles([]), cycles([[2, 3]]), cycles([[1, 2]]), cycles([[1, 2, 3]]), cycles([[1, 3, 2]]), cycles([[1, 3]])]

#% cell
length(group_elements(mathieu_group(11)))
#% output
#= 7920

