#! mathcas 2 notebook

#% title
# is_rational_expression

#% text
# `is_rational_expression(e, x)` tests whether `e` is a quotient of polynomials in `x` (or in a list of variables; in all its variables when none are given).

#% section
# Examples

#% subsection
# Basic examples

#% cell
is_rational_expression((x^2 + 1)/(x - 1), x)
#% output
#= true

#% cell
is_rational_expression(sin(x)/x, x)
#% output
#= false

#% cell
is_rational_expression(x/y)
#% output
#= true

#% section
# See also

#% text
# `together`, `apart`, `variables`
