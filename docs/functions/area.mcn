#! mathcas 2 notebook

#% title
# area

#% text
# `area(reg)` is the area of a two-dimensional region.

#% section
# Details

#% item
# Regions of lower dimension have area 0.

#% section
# Examples

#% subsection
# Basic examples

#% cell
area(disk())
#% output
#= pi

#% cell
area(triangle([[0, 0], [4, 0], [0, 3]]))
#% output
#= 6

