#! mathcas 2 notebook

#% title
# group_orbits

#% text
# `group_orbits(G), (G, n)`: the orbits on 1, ..., n (n the degree by default)

#% section
# Examples

#% subsection
# Basic examples

#% cell
group_orbits(permutation_group([cycles([[1, 2], [4, 5]])]))
#% output
#= [[1, 2], [3], [4, 5]]

#% cell
group_orbits(permutation_group([cycles([[1, 2], [4, 5]])]), 7)
#% output
#= [[1, 2], [3], [4, 5], [6], [7]]

