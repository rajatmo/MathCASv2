#! mathcas 2 notebook

#% title
# complement

#% text
# `complement(all, xs, ...)` gives the elements of `all` in none of the other lists, without repetitions, in canonical order.

#% section
# Details

#% item
# `same_test: f` decides when two elements are the same.

#% section
# Examples

#% subsection
# Basic examples

#% cell
complement([1, 2, 3, 4], [2], [4])
#% output
#= [1, 3]

#% subsection
# Scope

#% text
# A test of sameness:

#% cell
complement([1, 2, 3], [-2], same_test: (a, b) => abs(a) == abs(b))
#% output
#= [1, 3]

#% section
# See also

#% text
# `union`, `intersection`
