#% title
# left_coset_representatives

#% text
# `left_coset_representatives(G, H)`: representatives r of the left cosets r H of H in G

#% section
# Details

#% item
# The representatives are the inverses of right coset representatives.

#% section
# Examples

#% subsection
# Basic examples

#% cell
left_coset_representatives(symmetric_group(4), group_stabilizer(symmetric_group(4), 4))
#% output
#= [cycles([]), cycles([[1, 4, 3, 2]]), cycles([[2, 4, 3]]), cycles([[1, 3, 4, 2]])]

