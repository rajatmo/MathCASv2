#! mathcas 2 notebook

#% title
# minus

#% text
# `minus(x)` is `-x`: the negation as a function of one argument, to pass to `map`, `sort_by`, `key_sort_by` and the like.

#% section
# Examples

#% subsection
# Basic examples

#% cell
minus(5)
#% output
#= -5

#% cell
map(minus, [1, -2, a])
#% output
#= [-1, 2, -a]

#% cell
key_sort_by(assoc(1 -> x, 2 -> y, 3 -> z), minus)
#% output
#= assoc(3 -> z, 2 -> y, 1 -> x)

#% section
# See also

#% text
# `subtract`, `sort_by`, `key_sort_by`
