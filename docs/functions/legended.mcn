#! mathcas 2 notebook

#% title
# legended

#% text
# `legended(x, [labels])` is x with a legend at its right.

#% text
# `legended(x, line_legend([colours], [labels]))` gives each entry a colour swatch.

#% section
# Details

#% item
# x is a graphic or a plot. Around anything else (a function, data, a chart value) `legended` stays as it is: plots and charts read it as a legend entry.

#% section
# Examples

#% subsection
# Basic examples

#% text
# A graphic with a legend:

#% cell
legended(graphics([red, disk(), blue, disk([2, 0])]), line_legend([red, blue], ["first", "second"]))
#% output
#= image("legended.files/legended-1.png")

#% subsection
# Scope

#% text
# Labels only:

#% cell
legended(graphics(circle()), ["a circle"])
#% output
#= image("legended.files/legended-2.png")

#% subsection
# Applications

#% text
# A combined plot with one legend:

#% cell
legended(show(plot(sin(x), [x, 0, 6]), plot(cos(x), [x, 0, 6])), line_legend([gray], ["waves"]))
#% output
#= image("legended.files/legended-3.png")

#% subsection
# Properties and relations

#% text
# Around a function or data that is not a picture, `legended` stays as it is, so plots read it as a legend entry:

#% cell
plot([legended(x^2, "square"), legended(x^3, "cube")], [x, 0, 1])
#% output
#= image("legended.files/legended-4.png")

#% section
# See also

#% text
# `labeled`, `line_legend`, `plot`
