#! mathcas 2 notebook

#% title
# ambient_light

#% text
# `ambient_light(c)` is an ambient light of colour `c`, for the option `lighting` of 3D graphics.

#% section
# Details

#% item
# The 3D renderer shades faces with its own fixed light; `ambient_light` is accepted in graphics and plot options, so code written for other lighting runs, and is not drawn.

#% item
# The call stays as it is when evaluated alone.

#% section
# Examples

#% subsection
# Basic examples

#% cell
graphics3d(sphere(), lighting: [ambient_light(gray)])
#% output
#= image("ambient_light.files/ambient_light-1.svgz")

#% cell
plot3d(x^2 + y^2, [x, -1, 1], [y, -1, 1], lighting: [ambient_light(white)])
#% output
#= image("ambient_light.files/ambient_light-2.svgz")

#% cell
ambient_light(red)
#% output
#= ambient_light(red)

#% subsection
# Properties and relations

#% text
# The picture is the same without it:

#% cell
graphics3d([orange, sphere()])
#% output
#= image("ambient_light.files/ambient_light-4.svgz")

#% section
# See also

#% text
# `graphics3d`, `plot3d`, `lighting`, `directional_light`
