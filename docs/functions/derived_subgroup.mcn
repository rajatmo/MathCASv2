#! mathcas 2 notebook

#% title
# derived_subgroup

#% text
# `derived_subgroup(G)`: the commutator subgroup [G, G]

#% section
# Details

#% item
# The derived subgroup is the normal closure of the commutators of the generators.

#% section
# Examples

#% subsection
# Basic examples

#% cell
derived_subgroup(symmetric_group(4))
#% output
#= permutation_group([cycles([[1, 2, 3]]), cycles([[2, 3, 4]])])

#% cell
group_order(derived_subgroup(mathieu_group(11)))
#% output
#= 7920

