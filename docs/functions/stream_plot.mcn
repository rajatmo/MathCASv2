#! mathcas 2 notebook

#% title
# stream_plot

#% text
# `stream_plot([vx, vy], [x, a, b], [y, c, d])` draws streamlines of the vector field, spread evenly over the rectangle and coloured by magnitude.

#% section
# Details

#% item
# Option `plot_points` sets the number of grid points (arrows) or seeds (streamlines) per side.

#% section
# Examples

#% subsection
# Basic examples

#% cell
stream_plot([-1 - x^2 + y, 1 + x - y^2], [x, -3, 3], [y, -3, 3])
#% output
#= image("stream_plot.files/stream_plot-1.png")

#% cell
stream_plot([y, -sin(x)], [x, -4, 4], [y, -3, 3])
#% output
#= image("stream_plot.files/stream_plot-2.png")

#% section
# See also

#% text
# `vector_plot`
