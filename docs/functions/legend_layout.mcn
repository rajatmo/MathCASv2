#! mathcas 2 notebook

#% title
# legend_layout

#% text
# `legend_layout` is an option of graphics and plots: `column` (default) puts the entries one below the other, `row` side by side.

#% section
# Examples

#% subsection
# Basic examples

#% cell
plot([sin(x), cos(x), sin(2x)], [x, 0, 2pi], legend: ["a", "b", "c"], legend_layout: row)
#% output
#= image("legend_layout.files/legend_layout-1.png")

