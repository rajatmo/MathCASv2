#! mathcas 2 notebook

#% title
# partial_fraction_elements

#% text
# `partial_fraction_elements(r, x)` gives the parts of the partial fraction decomposition of the rational function r of x as an association.

#% text
# `partial_fraction_elements(r, x, key)` gives one part.

#% section
# Details

#% item
# The keys are `"Decomposition"`, `"PolynomialPart"`, `"FractionalPart"`, `"PolynomialCoefficients"` (constant term first), `"FractionalCoefficients"` (for each pole `[pole, multiplicity, [c1, ..., cm]]`, the term `cj/(x - pole)^j`), `"Poles"` and `"PoleMultiplicities"`.

#% section
# Examples

#% subsection
# Basic examples

#% cell
partial_fraction_elements(x^3/(x^2 + 3*x + 2), x)
#% output
#= assoc("Decomposition" -> -3 + x - (1 + x)^-1 + 8/(2 + x), "PolynomialPart" -> -3 + x, "FractionalPart" -> -1/(1 + x) + 8/(2 + x), "PolynomialCoefficients" -> [-3, 1], "FractionalCoefficients" -> [[-2, 1, [8]], [-1, 1, [-1]]], "Poles" -> [-2, -1], "PoleMultiplicities" -> [1, 1])

#% cell
partial_fraction_elements(x^3/(x + 2), x, "PolynomialPart")
#% output
#= 4 - 2*x + x^2

#% cell
partial_fraction_elements(x^2/(x^2 + x - 2), x, "FractionalCoefficients")
#% output
#= [[-2, 1, [-4/3]], [1, 1, [1/3]]]

#% cell
partial_fraction_elements(1/((x - 1)^2*(x + 1)), x, "Decomposition")
#% output
#= -1/(4*(-1 + x)) + 1/(4*(1 + x)) + 1/(2*(-1 + x)^2)

#% section
# See also

