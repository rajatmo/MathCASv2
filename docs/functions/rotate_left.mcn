#! mathcas 2 notebook

#% title
# rotate_left

#% text
# `rotate_left(xs)` cycles the elements of `xs` one place to the left; `rotate_left(xs, k)` cycles them `k` places.

#% section
# Details

#% item
# A negative `k` rotates to the right.

#% section
# Examples

#% subsection
# Basic examples

#% cell
rotate_left([1, 2, 3, 4])
#% output
#= [2, 3, 4, 1]

#% cell
rotate_left([1, 2, 3, 4], 2)
#% output
#= [3, 4, 1, 2]

#% subsection
# Scope

#% text
# Negative shifts go the other way:

#% cell
rotate_left([1, 2, 3, 4], -1)
#% output
#= [4, 1, 2, 3]

#% text
# Rotate the rows of a matrix:

#% cell
rotate_left([[1, 2], [3, 4], [5, 6]])
#% output
#= [[3, 4], [5, 6], [1, 2]]

#% section
# See also

#% text
# `rotate_right`, `reverse`, `take`, `drop`
