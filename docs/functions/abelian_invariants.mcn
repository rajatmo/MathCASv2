#! mathcas 2 notebook

#% title
# abelian_invariants

#% text
# `abelian_invariants(G)`: the elementary divisors of the abelianisation (0 for each infinite cyclic factor)

#% section
# Details

#% item
# The invariants are prime powers in increasing order, followed by a 0 for each infinite cyclic factor.

#% section
# Examples

#% subsection
# Basic examples

#% cell
abelian_invariants(abelian_group([4, 6]))
#% output
#= [2, 3, 4]

#% cell
abelian_invariants(symmetric_group(4))
#% output
#= [2]

#% cell
abelian_invariants(finitely_presented_group([a, b], [a^4, b^6, [a, b, a^-1, b^-1]]))
#% output
#= [2, 3, 4]

#% cell
abelian_invariants(finitely_presented_group([a, b, c], [[a, a, b]]))
#% output
#= [0, 0]

#% section
# See also

#% text
# `derived_subgroup`, `abelian_group`
