#% title
# sequence_fold

#% text
# `sequence_fold(f, init, xs)` and `sequence_fold(f, init, xs, n)` give the last value of `sequence_fold_list` with the same arguments.

#% section
# Examples

#% subsection
# Basic examples

#% cell
sequence_fold(add, [1, 1], constant_array(0, 10))
#% output
#= 144

#% cell
sequence_fold(f, [x, y], [a, b])
#% output
#= f(y, f(x, y, a), b)

