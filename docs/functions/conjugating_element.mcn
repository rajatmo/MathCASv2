#% title
# conjugating_element

#% text
# `conjugating_element(G, a, b)`: an element g of G with g^-1 a g = b

#% section
# Details

#% item
# When the elements are not conjugate the result is a failure.

#% section
# Examples

#% subsection
# Basic examples

#% cell
c = conjugating_element(symmetric_group(6), cycles([[1, 2, 3], [4, 5]]), cycles([[2, 6, 4], [1, 3]]))

#% cell
permutation_product(permutation_inverse(c), cycles([[1, 2, 3], [4, 5]]), c)
#% output
#= cycles([[1, 3], [2, 6, 4]])

