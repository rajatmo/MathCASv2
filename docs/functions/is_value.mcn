#! mathcas 2 notebook

#% title
# is_value

#% text
# `is_value(x)` tests whether `x` has a value: whether it evaluates to something other than itself.

#% section
# Details

#% item
# The argument is held.

#% section
# Examples

#% subsection
# Basic examples

#% cell
v = 3; is_value(v)
#% output
#= true

#% cell
is_value(undefined_symbol)
#% output
#= false

#% cell
is_value(1 + 1)
#% output
#= true

#% subsection
# Scope

#% cell
fn f(n) = n^2
is_value(f(2))
#% output
#= true

#% cell
is_value(f)
#% output
#= false

#% section
# See also

#% text
# `attributes`, `is_symbol`
