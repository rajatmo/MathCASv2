#! mathcas 2 notebook

#% title
# is_key_free

#% text
# `is_key_free(a, k)` is `true` when the association `a` does not have the key `k`.

#% section
# Details

#% item
# It is `not is_key_member(a, k)`.

#% section
# Examples

#% subsection
# Basic examples

#% cell
is_key_free(assoc(a -> 1, b -> 2), c)
#% output
#= true

#% cell
is_key_free(assoc(a -> 1, b -> 2), a)
#% output
#= false

#% section
# See also

#% text
# `is_key_member`, `key_exists`
