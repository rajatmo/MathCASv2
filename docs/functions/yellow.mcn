#! mathcas 2 notebook

#% title
# yellow

#% text
# `yellow` is the colour yellow, a directive for graphics and a value for plot options such as `colors:`.

#% section
# Examples

#% subsection
# Basic examples

#% cell
graphics([yellow, disk()])
#% output
#= image("yellow.files/yellow-1.png")

#% cell
plot(sin(x), [x, 0, 2pi], colors: [yellow])
#% output
#= image("yellow.files/yellow-2.png")

#% subsection
# Scope

#% text
# Lighter and darker shades:

#% cell
graphics([[lighter(yellow), disk([0, 0])], [yellow, disk([2, 0])], [darker(yellow), disk([4, 0])]])
#% output
#= image("yellow.files/yellow-3.png")

#% section
# See also

#% text
# `orange`, `green`, `rgb_color`
