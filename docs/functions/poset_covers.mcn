#% title
# poset_covers

#% text
# `poset_covers(P)`: the covering pairs [x, y] (the Hasse diagram)

#% section
# Examples

#% subsection
# Basic examples

#% cell
poset_covers(poset(divisors(12), (a, b) => mod(b, a) == 0))
#% output
#= [[1, 2], [1, 3], [2, 4], [2, 6], [3, 6], [4, 12], [6, 12]]

