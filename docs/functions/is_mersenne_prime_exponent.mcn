#! mathcas 2 notebook

#% title
# is_mersenne_prime_exponent

#% text
# `is_mersenne_prime_exponent(p)` tests whether `p` is the exponent of a known Mersenne prime.

#% section
# Examples

#% subsection
# Basic examples

#% cell
is_mersenne_prime_exponent(127)
#% output
#= true

#% cell
is_mersenne_prime_exponent(28)
#% output
#= false

#% cell
select(range(2, 130), is_mersenne_prime_exponent)
#% output
#= [2, 3, 5, 7, 13, 17, 19, 31, 61, 89, 107, 127]

