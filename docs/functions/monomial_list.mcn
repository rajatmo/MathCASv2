#! mathcas 2 notebook

#% title
# monomial_list

#% text
# `monomial_list(p, vars)` gives the terms of the polynomial `p` in decreasing lexicographic order of the exponents of `vars`.

#% section
# Examples

#% subsection
# Basic examples

#% cell
monomial_list(x^2 + 2*x*y + y^2, [x, y])
#% output
#= [x^2, 2*x*y, y^2]

#% cell
monomial_list(1 + x + x^2, x)
#% output
#= [x^2, x, 1]

