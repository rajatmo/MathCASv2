#! mathcas 2 notebook

#% title
# polygon_decomposition

#% text
# `polygon_decomposition(reg)`: a polygon without holes (or a rectangle, triangle, or a box given by bounds on each coordinate) as a list of convex pieces `polygon(corners, [1, ..., k])`, anticlockwise; a convex polygon is its own piece. `polygon_decomposition(reg, triangle)` gives triangles.

#% section
# Examples

#% subsection
# Basic examples

#% cell
polygon_decomposition(rectangle())
#% output
#= [polygon([[0, 0], [1, 0], [1, 1], [0, 1]], [1, 2, 3, 4])]

#% cell
polygon_decomposition(rectangle(), triangle)
#% output
#= [polygon([[0, 1], [0, 0], [1, 0]], [1, 2, 3]), polygon([[1, 0], [1, 1], [0, 1]], [1, 2, 3])]

#% cell
polygon_decomposition(implicit_region(0 <= x and x <= 2 and -1 <= y and y <= 1, [x, y]))
#% output
#= [polygon([[0, -1], [2, -1], [2, 1], [0, 1]], [1, 2, 3, 4])]

#% cell
polygon_decomposition(polygon([[0, 0], [4, 0], [4, 1], [1, 1], [1, 3], [0, 3]]), triangle)
#% output
#= [polygon([[0, 0], [4, 0], [4, 1]], [1, 2, 3]), polygon([[0, 0], [4, 1], [1, 1]], [1, 2, 3]), polygon([[0, 3], [0, 0], [1, 1]], [1, 2, 3]), polygon([[1, 1], [1, 3], [0, 3]], [1, 2, 3])]

#% cell
total(map(area, out()))
#% output
#= 6

