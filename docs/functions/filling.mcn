#! mathcas 2 notebook

#% title
# filling

#% text
# `filling` is an option of `plot`, `list_line_plot` and the joined list plots: it fills the area of each curve, faintly in the curve's colour.

#% section
# Details

#% item
# The values are `axis` (to the x axis), `bottom` and `top` (to the bottom or top of the plot), a number `c` (to the line `y = c`) and `[i, j]` (between curves `i` and `j`).

#% section
# Examples

#% subsection
# Basic examples

#% cell
plot(sin(x), [x, 0, 2*pi], filling: axis)
#% output
#= image("filling.files/filling-1.svgz")

#% cell
plot(exp(-x^2), [x, -2, 2], filling: bottom)
#% output
#= image("filling.files/filling-2.svgz")

#% cell
plot([sin(x), cos(x)], [x, 0, 2*pi], filling: [1, 2])
#% output
#= image("filling.files/filling-3.svgz")

#% subsection
# Scope

#% text
# To a horizontal line:

#% cell
plot(sin(x), [x, 0, 2*pi], filling: 0.5)
#% output
#= image("filling.files/filling-4.svgz")

#% cell
list_line_plot([1, 3, 2, 5, 4], filling: axis)
#% output
#= image("filling.files/filling-5.svgz")

#% section
# See also

#% text
# `plot`, `list_line_plot`, `top`, `bottom`
