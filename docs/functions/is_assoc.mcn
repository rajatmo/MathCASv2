#% title
# is_assoc

#% text
# `is_assoc(x)` gives `true` when `x` is an association.

#% section
# Examples

#% subsection
# Basic examples

#% cell
is_assoc(assoc("a" -> 1))
#% output
#= true

#% cell
is_assoc([a -> 1])
#% output
#= false

