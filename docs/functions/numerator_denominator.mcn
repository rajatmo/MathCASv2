#! mathcas 2 notebook

#% title
# numerator_denominator

#% text
# `numerator_denominator(e)` gives the list `[numerator(e), denominator(e)]`.

#% section
# Examples

#% subsection
# Basic examples

#% cell
numerator_denominator((x - 1)/(y + 2))
#% output
#= [-1 + x, 2 + y]

#% cell
numerator_denominator(3/4)
#% output
#= [3, 4]

