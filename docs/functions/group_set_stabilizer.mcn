#! mathcas 2 notebook

#% title
# group_set_stabilizer

#% text
# `group_set_stabilizer(G, [x1, ...])`: the subgroup mapping the set to itself

#% section
# Details

#% item
# The subgroup is found by backtrack search with the points of the set first in the base.

#% section
# Examples

#% subsection
# Basic examples

#% cell
group_order(group_set_stabilizer(symmetric_group(6), [1, 2]))
#% output
#= 48

#% cell
group_set_stabilizer(dihedral_group(6), [1, 4])
#% output
#= permutation_group([cycles([[2, 6], [3, 5]]), cycles([[1, 4], [2, 5], [3, 6]])])

