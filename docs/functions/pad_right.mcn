#! mathcas 2 notebook

#% title
# pad_right

#% text
# `pad_right(xs, n)` makes `xs` `n` long by adding zeros at the end, or by cutting elements from the end.
# `pad_right(xs, n, x)` pads with `x`; a list `x` is repeated cyclically.

#% section
# Examples

#% subsection
# Basic examples

#% cell
pad_right([1, 2, 3], 6)
#% output
#= [1, 2, 3, 0, 0, 0]

#% cell
pad_right([1, 2, 3], 5, x)
#% output
#= [1, 2, 3, x, x]

#% cell
pad_right([1, 2, 3, 4, 5], 3)
#% output
#= [1, 2, 3]

#% subsection
# Scope

#% text
# Pad a ragged list of lists to a rectangle:

#% cell
pad_right([[1], [2, 3], [4, 5, 6]])
#% output
#= [[1, 0, 0], [2, 3, 0], [4, 5, 6]]

#% section
# See also

#% text
# `pad_left`, `take`, `constant_array`
