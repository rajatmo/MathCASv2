#! mathcas 2 notebook

#% title
# values

#% text
# `values(a)` gives the list of the values of the association `a`, in the order of its entries.

#% section
# Details

#% item
# Repeated values are kept: there is one value per key.

#% item
# `keys` gives the keys in the same order.

#% section
# Examples

#% subsection
# Basic examples

#% cell
values(assoc("a" -> 1, "b" -> 2, "c" -> 1))
#% output
#= [1, 2, 1]

#% cell
values(assoc())
#% output
#= []

#% subsection
# Applications

#% text
# The total of a column of counts:

#% cell
total(values(counts(characters("banana"))))
#% output
#= 6

#% text
# The largest group made by `group_by`:

#% cell
max(map(length, values(group_by(range(20), is_prime))))
#% output
#= 12

#% text
# Statistics of the values of a parameter table:

#% cell
masses = assoc("e" -> 0.511, "mu" -> 105.66, "tau" -> 1776.9)
[min(values(masses)), max(values(masses))]
#% output
#= [0.511, 1776.9]

#% subsection
# Properties and relations

#% text
# The values with `map_values` applied:

#% cell
values(map_values(v => 1000*v, masses))
#% output
#= [511.0, 105660.0, 1776900.0]

#% text
# `to_rules` keeps keys and values together:

#% cell
to_rules(masses)
#% output
#= ["e" -> 0.511, "mu" -> 105.66, "tau" -> 1776.9]

#% section
# See also

#% text
# `keys`, `assoc`, `map_values`, `lookup`, `to_rules`
