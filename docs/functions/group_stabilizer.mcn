#! mathcas 2 notebook

#% title
# group_stabilizer

#% text
# `group_stabilizer(G, x), (G, [x1, ...])`: the subgroup fixing the points

#% section
# Details

#% item
# With a list, the pointwise stabiliser of all the points.

#% section
# Examples

#% subsection
# Basic examples

#% cell
s = group_stabilizer(mathieu_group(11), 1); group_order(s)
#% output
#= 720

#% cell
group_order(s) * length(group_orbit(mathieu_group(11), 1))
#% output
#= 7920

#% cell
group_order(group_stabilizer(mathieu_group(24), [1, 2, 3, 4, 5]))
#% output
#= 48

