#! mathcas 2 notebook

#% title
# sequence_replace

#% text
# `sequence_replace(xs, p -> r)` gives `xs` with each run that matches the list pattern `p` replaced by the single element `r`.

#% section
# Details

#% item
# Elements outside the runs stay; the result is evaluated.

#% section
# Examples

#% subsection
# Basic examples

#% cell
sequence_replace([1, 2, 3, 4, 5], [2, 3] -> x)
#% output
#= [1, x, 4, 5]

#% cell
sequence_replace([1, 1, 2, 2, 2], [x_, x_] -> 10x)
#% output
#= [10, 20, 2]

#% subsection
# Properties and relations

#% text
# `rewrite` replaces single elements:

#% cell
rewrite([1, 2, 3], 2 -> x)
#% output
#= [1, x, 3]

#% section
# See also

#% text
# `sequence_cases`, `rewrite`, `replace`
