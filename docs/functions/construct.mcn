#! mathcas 2 notebook

#% title
# construct

#% text
# `construct(f, a, b, ...)` builds and evaluates the call `f(a, b, ...)`.

#% section
# Details

#% item
# `f` may be any expression, such as a lambda or a call.

#% section
# Examples

#% subsection
# Basic examples

#% cell
construct(f, a, b)
#% output
#= f(a, b)

#% cell
construct(add, 1, 2, 3)
#% output
#= 6

#% cell
construct(f)
#% output
#= f()

#% subsection
# Scope

#% cell
construct(x => x^2, 5)
#% output
#= 25

#% cell
construct(g(1), 2)
#% output
#= g(1)(2)

#% section
# See also

#% text
# `apply`, `map`, `comap`
