#! mathcas 2 notebook

#% title
# geometric_distribution

#% text
# `geometric_distribution(p)` is the distribution of the number of failures before the first success in trials with success probability `p`, `0 < p <= 1`.

#% section
# Examples

#% subsection
# Basic examples

#% cell
pdf(geometric_distribution(p), k)
#% output
#= piecewise([[p*(1 - p)^k, k >= 0]], 0)

#% cell
mean(geometric_distribution(p))
#% output
#= (1 - p)/p

#% cell
pdf(geometric_distribution(1/6), 2)
#% output
#= 25/216

#% subsection
# Scope

#% text
# At most two failures before a six:

#% cell
cdf(geometric_distribution(1/6), 2)
#% output
#= 91/216

#% section
# See also

#% text
# `binomial_distribution`, `exponential_distribution`, `pdf`
