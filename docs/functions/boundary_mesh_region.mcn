#% title
# boundary_mesh_region

#% text
# `boundary_mesh_region(points, cells)`: the solid region bounded by the cells (points in 1D, lines in 2D, polygons in 3D)

#% section
# Examples

#% subsection
# Basic examples

#% cell
b = boundary_mesh_region([[0, 0], [3, 0], [3, 3], [0, 3], [1, 1], [2, 1], [2, 2], [1, 2]], line([1, 2, 3, 4, 1]), line([5, 6, 7, 8, 5]))

#% cell
area(b)
#% output
#= 8.0

