#% title
# abelian_group

#% text
# `abelian_group([n1, n2, ...])`: the direct product of cyclic groups of these orders

#% section
# Examples

#% subsection
# Basic examples

#% cell
abelian_group([2, 3])
#% output
#= permutation_group([cycles([[1, 2]]), cycles([[3, 4, 5]])])

#% cell
abelian_invariants(abelian_group([4, 6]))
#% output
#= [2, 3, 4]

