#! mathcas 2 notebook

#% title
# list_line_plot3d

#% text
# `list_line_plot3d([[x1, y1, z1], ...])` draws a line through points in space with axes.

#% section
# Details

#% item
# The value is `image("path")`, a PNG with SVG and PDF copies next to it.

#% section
# Examples

#% subsection
# Basic examples

#% text
# A spiral:

#% cell
list_line_plot3d(table([t*cos(t), t*sin(t), t], t, range(0, 20, 0.1)))
#% output
#= image("list_line_plot3d.files/list_line_plot3d-1.svgz")

#% subsection
# Scope

#% text
# A random walk:

#% cell
seed(2); list_line_plot3d(table([random_real(), random_real(), k/100], k, 100))
#% output
#= image("list_line_plot3d.files/list_line_plot3d-2.svgz")

#% subsection
# Options

#% text
# Seen from above:

#% cell
list_line_plot3d(table([cos(t), sin(t), t], t, range(0, 10, 0.1)), view_point: above)
#% output
#= image("list_line_plot3d.files/list_line_plot3d-3.svgz")

#% section
# See also

#% text
# `list_point_plot3d`, `parametric_plot3d`
