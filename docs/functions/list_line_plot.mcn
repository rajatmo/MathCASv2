#! mathcas 2 notebook

#% title
# list_line_plot

#% text
# `list_line_plot([y1, y2, ...])` draws a line through the points (1, y1), (2, y2), ....

#% text
# `list_line_plot([[x1, y1], [x2, y2], ...])` draws a line through the given points, in order.

#% text
# `list_line_plot([data1, data2, ...])` draws a line for each data set.

#% section
# Details

#% item
# The value is `image("path")`, a PNG file with SVG and PDF copies next to it.

#% item
# It is `list_plot` with the points joined; a value that is not a real number breaks the line.

#% item
# A list of lists is several data sets unless every inner list is a pair of numbers.

#% item
# Options: those of `plot`, including `filling`, `x_scale` and `y_scale`.

#% section
# Examples

#% subsection
# Basic examples

#% text
# Values at 1, 2, 3, ...:

#% cell
list_line_plot([1, 4, 2, 5, 3, 6])
#% output
#= image("list_line_plot.files/list_line_plot-1.svgz")

#% text
# Points given with their x coordinates:

#% cell
list_line_plot([[0, 0], [1, 2], [3, 1], [6, 4]])
#% output
#= image("list_line_plot.files/list_line_plot-2.svgz")

#% subsection
# Scope

#% text
# Two data sets with a legend:

#% cell
list_line_plot([table(k^2, k, 8), table(8k, k, 8)], legend: ["squares", "multiples of 8"])
#% output
#= image("list_line_plot.files/list_line_plot-3.svgz")

#% subsection
# Options

#% text
# The region under the line filled:

#% cell
list_line_plot(table(sin(k/3), k, 40), filling: axis)
#% output
#= image("list_line_plot.files/list_line_plot-4.svgz")

#% subsection
# Properties and relations

#% text
# Data sets wrapped in `legended` or `labeled`:

#% cell
list_line_plot([legended(range(10)^0.5, "root"), labeled(log(range(10)), "log")])
#% output
#= image("list_line_plot.files/list_line_plot-5.svgz")

#% section
# See also

#% text
# `list_plot`, `plot`, `bar_chart`
