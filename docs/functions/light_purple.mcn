#! mathcas 2 notebook

#% title
# light_purple

#% text
# `light_purple` is the colour light purple, a pale tint of `purple`: a directive for graphics and a value for plot options such as `colors:`.

#% section
# Details

#% item
# `light_purple` is a named colour like `purple`; it stays a symbol until a graphic draws it.

#% item
# Pale tints suit filled areas and backgrounds behind darker curves.

#% section
# Examples

#% subsection
# Basic examples

#% cell
graphics([light_purple, disk()])
#% output
#= image("light_purple.files/light_purple-1.svgz")

#% cell
plot([sin(x), cos(x)], [x, 0, 2*pi], colors: [purple, light_purple])
#% output
#= image("light_purple.files/light_purple-2.svgz")

#% cell
light_purple
#% output
#= light_purple

#% subsection
# Scope

#% text
# The tint beside the full colour and its darker shade:

#% cell
graphics([[light_purple, disk([0, 0])], [purple, disk([2, 0])], [darker(purple), disk([4, 0])]])
#% output
#= image("light_purple.files/light_purple-4.svgz")

#% subsection
# Applications

#% text
# A pale band behind a curve:

#% cell
graphics([[light_purple, rectangle([0, -1], [3, 1])], [black, line(table([t, sin(2*t)], t, range(0, 3, 0.05)))]])
#% output
#= image("light_purple.files/light_purple-5.svgz")

#% section
# See also

#% text
# `purple`, `light_gray`, `lighter`, `rgb_color`, `light_brown`
