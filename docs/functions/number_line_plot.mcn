#! mathcas 2 notebook

#% title
# number_line_plot

#% text
# `number_line_plot(items)` draws numbers as points and intervals as segments on a number line; `number_line_plot(cond, x)` draws where a condition on x holds.

#% section
# Details

#% item
# A list of lists gives a row per list.

#% item
# `number_line_plot(items, [x, a, b])` sets the range.

#% section
# Examples

#% subsection
# Basic examples

#% cell
number_line_plot([1, 2, 5])
#% output
#= image("number_line_plot.files/number_line_plot-1.png")

#% cell
number_line_plot(x^2 < 4, x)
#% output
#= image("number_line_plot.files/number_line_plot-2.png")

#% cell
number_line_plot([[1, 3], [interval([2, 4])]])
#% output
#= image("number_line_plot.files/number_line_plot-3.png")

#% section
# See also

#% text
# `plot`
