#! mathcas 2 notebook

#% title
# shearing_matrix

#% text
# `shearing_matrix(theta, v, w)` gives the matrix of the shear by the angle `theta` in the direction `v` along the plane normal to `w`.

#% section
# Details

#% item
# The matrix is the identity plus `tan(theta)` times the outer product of the unit vectors along `v` and `w`.

#% item
# The vectors `v` and `w` should be perpendicular.

#% section
# Examples

#% subsection
# Basic examples

#% cell
shearing_matrix(t, [1, 0], [0, 1])
#% output
#= [[1, tan(t)], [0, 1]]

#% cell
shearing_matrix(t, [0, 1], [1, 0])
#% output
#= [[1, 0], [tan(t), 1]]

#% cell
shearing_matrix(pi/4, [1, 0, 0], [0, 0, 1])
#% output
#= [[1, 0, 1], [0, 1, 0], [0, 0, 1]]

#% cell
dot(shearing_matrix(pi/4, [1, 0], [0, 1]), [0, 1])
#% output
#= [1, 1]

