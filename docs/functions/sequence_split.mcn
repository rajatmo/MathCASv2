#! mathcas 2 notebook

#% title
# sequence_split

#% text
# `sequence_split(xs, p)` gives the pieces of `xs` between the runs that match the list pattern `p`.

#% text
# `sequence_split(xs, p -> r)` keeps each run's `r` between the pieces.

#% section
# Details

#% item
# Empty pieces (at the ends, or between adjacent runs) are left out.

#% section
# Examples

#% subsection
# Basic examples

#% cell
sequence_split([1, 2, 0, 3, 4, 0, 5], [0])
#% output
#= [[1, 2], [3, 4], [5]]

#% cell
sequence_split([a, b, x, x, c], [x, x] -> sep)
#% output
#= [[a, b], sep, [c]]

#% subsection
# Properties and relations

#% text
# `split` splits into runs of equal elements:

#% cell
split([1, 1, 2, 3, 3])
#% output
#= [[1, 1], [2], [3, 3]]

#% section
# See also

#% text
# `sequence_cases`, `split`, `partition`
