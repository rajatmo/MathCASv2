#! mathcas 2 notebook

#% title
# characters

#% text
# `characters(s)` gives the list of the characters of the string `s`, each as a one-character string.

#% section
# Details

#% item
# Characters are Unicode characters, not bytes.

#% item
# `from_characters` and `string_join` turn the list back into a string.

#% section
# Examples

#% subsection
# Basic examples

#% cell
characters("hello")
#% output
#= ["h", "e", "l", "l", "o"]

#% cell
characters("")
#% output
#= []

#% cell
characters("π ≈ 3.14")
#% output
#= ["π", " ", "≈", " ", "3", ".", "1", "4"]

#% subsection
# Applications

#% text
# Letter frequencies:

#% cell
tally(characters("mississippi"))
#% output
#= [["m", 1], ["i", 4], ["s", 4], ["p", 2]]

#% text
# A palindrome test:

#% cell
fn is_palindrome(s) = characters(s) === reverse(characters(s))
[is_palindrome("level"), is_palindrome("levels")]
#% output
#= [true, false]

#% text
# The digits of a number written as text:

#% cell
map(to_expression, characters("2026"))
#% output
#= [2, 0, 2, 6]

#% subsection
# Properties and relations

#% text
# The number of characters is the string's length:

#% cell
length(characters("naïve")) == string_length("naïve")
#% output
#= true

#% text
# `from_characters` puts them back together:

#% cell
from_characters(reverse(characters("drawer")))
#% output
#= "reward"

#% section
# See also

#% text
# `from_characters`, `string_length`, `string_join`, `string_reverse`, `tally`
