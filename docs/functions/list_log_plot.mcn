#! mathcas 2 notebook

#% title
# list_log_plot

#% text
# `list_log_plot(data)` is `list_plot` with a logarithmic y axis.

#% section
# Examples

#% subsection
# Basic examples

#% cell
list_log_plot(table(2^k, k, 20))
#% output
#= image("list_log_plot.files/list_log_plot-1.png")

#% subsection
# Scope

#% text
# Exponential decay looks straight:

#% cell
list_log_plot(map(t => [t, n(exp(-t/3))], range(0, 20)), joined: true)
#% output
#= image("list_log_plot.files/list_log_plot-2.png")

