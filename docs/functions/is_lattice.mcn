#! mathcas 2 notebook

#% title
# is_lattice

#% text
# `is_lattice(P)`: whether every two elements have a join and a meet

#% section
# Examples

#% subsection
# Basic examples

#% cell
is_lattice(poset(divisors(12), (a, b) => mod(b, a) == 0))
#% output
#= true

#% cell
is_lattice(poset([1, 2, 3, 4], [[1, 3], [1, 4], [2, 3], [2, 4]]))
#% output
#= false

