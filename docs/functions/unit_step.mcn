#! mathcas 2 notebook

#% title
# unit_step

#% text
# `unit_step(x)` gives 1 for `x >= 0` and 0 for `x < 0`.

#% text
# `unit_step(x1, x2, ...)` gives 1 when every argument is at least 0.

#% section
# Details

#% item
# Exact for every kind of real number; symbols stay unevaluated.

#% item
# `unit_step` is listable.

#% section
# Examples

#% subsection
# Basic examples

#% cell
unit_step(2)
#% output
#= 1

#% cell
unit_step(-0.5)
#% output
#= 0

#% cell
unit_step(0)
#% output
#= 1

#% cell
unit_step(1, -1)
#% output
#= 0

#% subsection
# Scope

#% text
# Each element of a list:

#% cell
unit_step([-2, -1, 0, 1, 2])
#% output
#= [0, 0, 1, 1, 1]

#% subsection
# Applications

#% text
# A rectangular pulse:

#% cell
plot(unit_step(x - 1) - unit_step(x - 3), [x, 0, 4])
#% output
#= image("unit_step.files/unit_step-6.svgz")

#% subsection
# Properties and relations

#% text
# The integral of the step is a ramp:

#% cell
integrate(unit_step(t), [t, -1, 2])
#% output
#= 2

#% subsection
# Possible issues

#% text
# `refine` decides the step from the sign the assumptions give (`unit_step(0)` is 1, so a nonnegative argument gives 1):

#% cell
assuming(x > 0, refine(unit_step(x)))
#% output
#= 1

#% section
# See also

#% text
# `sign`, `clip`, `piecewise`
