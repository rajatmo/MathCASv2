#! mathcas 2 notebook

#% title
# axes_label

#% text
# `axes_label` is an option of graphics and plots: `axes_label: [x_label, y_label]` labels the axes of a graphic or plot; a single label is the y axis's.

#% section
# Examples

#% subsection
# Basic examples

#% cell
plot(x^3, [x, -2, 2], axes: true, frame: false, axes_label: ["x", "y"])
#% output
#= image("axes_label.files/axes_label-1.svgz")

#% subsection
# Scope

#% text
# TeX labels as raw strings:

#% cell
plot(exp(-t), [t, 0, 4], axes: true, frame: false, axes_label: [r"$t$", r"$e^{-t}$"])
#% output
#= image("axes_label.files/axes_label-2.svgz")

#% section
# See also

#% text
# `axes`, `frame_label`, `x_label`
