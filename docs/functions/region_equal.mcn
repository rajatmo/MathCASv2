#% title
# region_equal

#% text
# `region_equal(r1, r2, ...)`: whether the regions are the same set of points (regions of the line and plane polygons)

#% section
# Examples

#% subsection
# Basic examples

#% cell
[region_equal(line([[0], [1]]), interval([0, 1])), region_equal(rectangle(), polygon([[0, 0], [1, 0], [1, 1], [0, 1]]))]
#% output
#= [true, true]

