#! mathcas 2 notebook

#% title
# exponential_distribution

#% text
# `exponential_distribution(l)` is the exponential distribution with rate `l > 0`; its mean is `1/l`.

#% section
# Examples

#% subsection
# Basic examples

#% cell
pdf(exponential_distribution(l), x)
#% output
#= piecewise([[l*exp(-l*x), x >= 0]], 0)

#% cell
mean(exponential_distribution(l))
#% output
#= l^-1

#% cell
cdf(exponential_distribution(2), 1)
#% output
#= 1 - exp(-2)

#% subsection
# Scope

#% text
# Its moments:

#% cell
moment(exponential_distribution(l), 3)
#% output
#= 6/l^3

#% text
# Waiting times from draws:

#% cell
seed(2); mean(random_variate(exponential_distribution(0.5), 100000))
#% output
#= 1.9977263710483335

#% section
# See also

#% text
# `gamma_distribution`, `poisson_distribution`, `pdf`
