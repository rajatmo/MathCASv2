#% text
# `inverse_robinson_schensted(P, Q)`: the word with insertion tableau P and recording tableau Q

#% section
# Examples

#% subsection
# Basic examples

#% cell
inverse_robinson_schensted([[1, 2, 5], [3, 4]], [[1, 3, 5], [2, 4]])
#% output
#= [3, 1, 4, 2, 5]

#% cell
inverse_robinson_schensted(robinson_schensted([4, 7, 1, 3, 6, 2, 5])[1], robinson_schensted([4, 7, 1, 3, 6, 2, 5])[2])
#% output
#= [4, 7, 1, 3, 6, 2, 5]

