#! mathcas 2 notebook

#% title
# length_while

#% text
# `length_while(xs, f)` gives how many elements of `xs`, from the start, have `f(x)` equal to `true`.

#% section
# Examples

#% subsection
# Basic examples

#% cell
length_while([1, 1, 2, 3, 5, 8, 13, 21], x => x < 10)
#% output
#= 6

#% cell
length_while(f(1, 2, a, 3), is_integer)
#% output
#= 2

