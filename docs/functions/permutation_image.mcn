#! mathcas 2 notebook

#% title
# permutation_image

#% text
# `permutation_image(p, x)`: the image of the point x (or of each point of a list)

#% section
# Details

#% item
# Points the permutation does not move are their own images.

#% section
# Examples

#% subsection
# Basic examples

#% cell
permutation_image(cycles([[1, 3, 2]]), 1)
#% output
#= 3

#% cell
permutation_image(cycles([[1, 3, 2]]), [1, 2, 3, 4])
#% output
#= [3, 1, 2, 4]

#% section
# See also

#% text
