#! mathcas 2 notebook

#% title
# is_symmetric_matrix

#% text
# `is_symmetric_matrix(m)` gives `true` if the square matrix `m` equals its transpose.

#% section
# Details

#% item
# Inexact entries are compared up to rounding.

#% item
# Anything that is not a square matrix gives `false`.

#% section
# Examples

#% subsection
# Basic examples

#% cell
is_symmetric_matrix([[1, 2], [2, 3]])
#% output
#= true

#% cell
is_symmetric_matrix([[1, 2], [3, 3]])
#% output
#= false

#% cell
is_symmetric_matrix([[a, b], [b, c]])
#% output
#= true

#% cell
is_symmetric_matrix([[1, 2, 3], [2, 3, 4]])
#% output
#= false

#% section
# See also

#% text
# `is_positive_definite_matrix`, `transpose`, `is_diagonal_matrix`
