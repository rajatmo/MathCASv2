#! mathcas 2 notebook

#% title
# upper_triangularize

#% text
# `upper_triangularize(m)` replaces the entries of `m` below the main diagonal by zeros; `upper_triangularize(m, k)` those below the `k`-th diagonal.

#% section
# Details

#% item
# The matrix need not be square.

#% item
# A matrix of machine reals gets machine zeros.

#% section
# Examples

#% subsection
# Basic examples

#% cell
upper_triangularize([[1, 2, 3], [4, 5, 6], [7, 8, 9]])
#% output
#= [[1, 2, 3], [0, 5, 6], [0, 0, 9]]

#% cell
upper_triangularize([[1, 2, 3], [4, 5, 6], [7, 8, 9]], 1)
#% output
#= [[0, 2, 3], [0, 0, 6], [0, 0, 0]]

#% cell
upper_triangularize([[1, 2, 3], [4, 5, 6], [7, 8, 9]], -1)
#% output
#= [[1, 2, 3], [4, 5, 6], [0, 8, 9]]

#% cell
upper_triangularize([[a, b, c, d], [e, f, g, h]])
#% output
#= [[a, b, c, d], [0, f, g, h]]

#% section
# See also

#% text
# `lower_triangularize`, `upper_triangular_matrix_q`, `diagonal`
