#! mathcas 2 notebook

#% title
# legend_font_size

#% text
# `legend_font_size` is an option of graphics and plots: `legend_font_size: p` sets the height of the legend's labels to `p` points.

#% section
# Details

#% item
# The default is the graphic's `font_size`.

#% section
# Examples

#% subsection
# Basic examples

#% cell
plot([sin(x), cos(x)], [x, 0, 6], plot_legends: ["sin", "cos"], legend_font_size: 18)
#% output
#= image("legend_font_size.files/legend_font_size-1.svgz")

#% cell
plot([sin(x), cos(x)], [x, 0, 6], plot_legends: ["sin", "cos"], legend_font_size: 8)
#% output
#= image("legend_font_size.files/legend_font_size-2.svgz")

#% cell
plot(x^2, [x, 0, 1], plot_legends: [x^2], legend_font_size: 14, font_size: 10)
#% output
#= image("legend_font_size.files/legend_font_size-3.svgz")

#% section
# See also

#% text
# `plot_legends`, `font_size`, `legend`
