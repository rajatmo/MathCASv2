#! mathcas 2 notebook

#% title
# dot_dashed

#% text
# `dot_dashed` is a graphics directive: dot-dashed lines.

#% section
# Details

#% item
# It applies to what follows it in its list; it can stand in `directive(...)`, `edge_form(...)` and `plot_style`.

#% section
# Examples

#% subsection
# Basic examples

#% text
# In a graphic:

#% cell
graphics([dot_dashed, line([[0, 0], [2, 1]])])
#% output
#= image("dot_dashed.files/dot_dashed-1.svgz")

#% subsection
# Scope

#% text
# As a plot style:

#% cell
plot(sin(x), [x, 0, 6], plot_style: dot_dashed)
#% output
#= image("dot_dashed.files/dot_dashed-2.svgz")

#% subsection
# Properties and relations

#% text
# Combined with a colour:

#% cell
graphics([directive(red, dot_dashed), line([[0, 0], [1, 1]])])
#% output
#= image("dot_dashed.files/dot_dashed-3.svgz")

#% section
# See also

#% text
# `directive`, `thickness`, `dashing`
