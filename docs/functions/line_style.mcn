#! mathcas 2 notebook

#% title
# line_style

#% text
# `line_style` is an option of `plot` and the joined list plots: `line_style: [s1, s2, ...]` gives the style of each curve in order: `solid`, `dashed`, `dotted` or `dot_dashed`.

#% section
# Details

#% item
# Curves beyond the list are solid.

#% section
# Examples

#% subsection
# Basic examples

#% cell
plot([sin(x), cos(x)], [x, 0, 2*pi], line_style: [dashed, dotted])
#% output
#= image("line_style.files/line_style-1.svgz")

#% cell
plot([x, x^2, x^3], [x, 0, 1], line_style: [solid, dashed, dot_dashed])
#% output
#= image("line_style.files/line_style-2.svgz")

#% cell
list_line_plot([[1, 3, 2, 4], [4, 2, 3, 1]], line_style: [dotted])
#% output
#= image("line_style.files/line_style-3.svgz")

#% section
# See also

#% text
# `line_thickness`, `plot_style`, `dashed`, `colors`
