#! mathcas 2 notebook

#% title
# key

#% text
# `key(k)`: the operator form of a lookup: `key(k)(a)` is `lookup(a, k)`, and `a(key(k))` is the same

#% section
# Examples

#% subsection
# Basic examples

#% cell
a = assoc("x" -> 1, "y" -> 2)

#% cell
key("x")(a)
#% output
#= 1

#% cell
a(key("y"))
#% output
#= 2

#% cell
map(key("x"), [a, assoc("x" -> 5)])
#% output
#= [1, 5]

#% section
# See also

#% text
# `lookup`, `key_take`, `key_exists`, `keys`
