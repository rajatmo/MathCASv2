#! mathcas 2 notebook

#% title
# below

#% text
# `below` is the side below: a position for `placed`, for the label of `labeled` and for the corner of a placed legend.

#% section
# Details

#% item
# `placed(obj, below)` puts `obj` below the plot area; `labeled(g, label, below)` puts the label below the graphic.

#% item
# In `plot_legends: placed(entries, below)` the legend goes to the nearest corner of the plot.

#% section
# Examples

#% subsection
# Basic examples

#% cell
graphics([circle(), placed("label", below)])
#% output
#= image("below.files/below-1.svgz")

#% cell
labeled(graphics([blue, disk()], image_size: 120), "a disk", below)
#% output
#= image("below.files/below-2.svgz")

#% cell
plot([sin(x), cos(x)], [x, 0, 2*pi], plot_legends: placed(["sin", "cos"], below))
#% output
#= image("below.files/below-3.svgz")

#% section
# See also

#% text
# `placed`, `labeled`, `left`, `right`, `above`, `bottom`
