#! mathcas 2 notebook

#% title
# pad_left

#% text
# `pad_left(xs, n)` makes `xs` `n` long by adding zeros at the start, or by cutting elements from the start.
# `pad_left(xs, n, x)` pads with `x`; a list `x` is repeated cyclically.

#% section
# Examples

#% subsection
# Basic examples

#% cell
pad_left([1, 2, 3], 6)
#% output
#= [0, 0, 0, 1, 2, 3]

#% cell
pad_left([1, 2, 3], 5, x)
#% output
#= [x, x, 1, 2, 3]

#% cell
pad_left([1, 2, 3, 4, 5], 3)
#% output
#= [3, 4, 5]

#% subsection
# Scope

#% text
# Pad with a repeating pattern:

#% cell
pad_left([1, 2], 6, [a, b])
#% output
#= [a, b, a, b, 1, 2]

#% text
# Digits with leading zeros:

#% cell
pad_left(integer_digits(42), 5)
#% output
#= [0, 0, 0, 4, 2]

#% section
# See also

#% text
# `pad_right`, `take`, `drop`, `integer_digits`
