#! mathcas 2 notebook

#% title
# string_contains

#% text
# `string_contains(s, sub)` gives `true` when `s` contains `sub`; with a list of strings, when it contains one of them.

#% section
# Examples

#% subsection
# Basic examples

#% cell
string_contains("integration", "grat")
#% output
#= true

#% cell
string_contains("integration", "diff")
#% output
#= false

#% cell
string_contains("plot3d", ["2d", "3d"])
#% output
#= true

#% subsection
# Scope

#% text
# A string pattern:

#% cell
string_contains("version 12", repeated(digit_character))
#% output
#= true

#% text
# Filter a list of names:

#% cell
select(["plot", "plot3d", "list_plot"], s => string_contains(s, "3d"))
#% output
#= ["plot3d"]

#% section
# See also

#% text
# `string_starts`, `string_ends`, `string_replace`
