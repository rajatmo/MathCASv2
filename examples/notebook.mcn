#! mathcas 2 notebook

#% text
# A notebook: text cells, code cells and the output of the last run. `mc-repl examples/notebook.mcn` runs
# the code cells in order in one session; `mc-repl --update examples/notebook.mcn` also writes each cell's
# output back below it. Output lines start with `#|` (print), `#=` (the value of the cell) or `#!` (failures
# and errors).

#% cell
# exact arithmetic and big integers
print(1/3 + 1/6)
2^100
#% output
#| 1/2
#= 1267650600228229401496703205376

#% text
# Definitions made in one cell are seen by the cells after it.

#% cell
fn collatz(1) = [1]
fn collatz(n: Int) = prepend(collatz(if is_even(n) then n/2 else 3n + 1), n)
let path = collatz(27)
say("steps: ", length(path) - 1, ", highest: ", max(path))
#% output
#| steps: 111, highest: 9232

#% cell
# a failure is reported, and the run goes on
1/0
collatz(6)
#% output
#! failure(division_by_zero)
#= [6, 3, 10, 5, 16, 8, 4, 2, 1]

#% text
# Modules: `vectors.mc` is next to this notebook; `stats` is built in.

#% cell
import vectors
import stats.{mean, median}
plus(e1, times(2, e2))
#% output
#= [1, 2]

#% cell
let readings = [21, 19, 24, 22, 23]
[mean(readings), median(readings)]
#% output
#= [109/5, 22]
